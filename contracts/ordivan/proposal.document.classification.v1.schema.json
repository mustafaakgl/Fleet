{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/ordivan/proposal.document.classification.v1.schema.json",
  "title": "proposal.document.classification.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "documentKind": {
      "type": "string",
      "enum": [
        "invoice",
        "delivery_note",
        "fuel_receipt",
        "insurance",
        "other"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "issuedAt": {
      "type": "string",
      "maxLength": 40
    }
  },
  "required": [
    "documentKind",
    "confidence"
  ]
}
