{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/ordivan/job.transport_order.extract.v1.schema.json",
  "title": "job.transport_order.extract.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "type": "string",
      "maxLength": 64
    },
    "attachmentIntakeIds": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://fleet.local/contracts/ordivan/item.schema.json",
        "title": "item",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "contentLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50000000
