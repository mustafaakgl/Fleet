/// Bordro kalem turleri. DATEV Lohnart numaralari koda GOMULMUYOR; bu enum
/// yalnizca "hangi kova" diyor, numarayi PayrollWageTypeMapping veriyor.
/// Normalize bordro hareketinin turu.
///
/// DATEV'in Lohnart'i DEGIL: bu Fleet'in kendi dili. Disariya cikan numara
/// PayrollWageTypeMapping'den geliyor, boylece yarin DATEV yerine baska bir
/// bordro sistemi eklendiginde hesap katmani hic degismiyor.
enum PayrollMovementType {
  regular_hours
  overtime_hours
  night_hours
  /// §3b EStG'nin daha yuksek oranli 00–04 bandi; ayri Lohnart alabilir.
  night_core_hours
  sunday_hours
  holiday_hours
  vacation
  sickness
  unpaid_absence
  /// Para tutarli hareketler. Hesap katmani bunlari HENUZ uretmiyor; model
  /// simdiden tasiyor ki spesen/zulage geldiginde sema degismesin.
  allowance
  expense
}

