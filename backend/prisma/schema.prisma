  finalizedById        String?
  finalizedBy          User?                    @relation("InvoiceFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
