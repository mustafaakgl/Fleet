/// Geocode edilmis, yeniden kullanilabilir adres. Ayni adres tenant icinde bir kez
/// geocode edilir (normalizedHash), sonraki gorevler ayni kaydi paylasir.
model Location {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Kullanicinin girdigi ham metin — geriye donuk izlenebilirlik icin saklanir
  rawAddress     String
  /// Kucuk harf + noktalama/bosluk sadelestirilmis hali; tenant ici tekillik anahtari
  normalizedHash String
  /// Operasyonda gorunen ad, ornegin "Werk Duisburg" veya "Rampe 3"
  label          String?
  street         String?
  houseNumber    String?
  postalCode     String?
  city           String?
  countryCode    String  @default("DE")

  latitude          Decimal?       @db.Decimal(10, 7)
  longitude         Decimal?       @db.Decimal(10, 7)
  geocodeSource     GeocodeSource?
  geocodeConfidence Decimal?       @db.Decimal(4, 3)
  geocodedAt        DateTime?

  truckAccess          TruckAccessStatus @default(unknown)
  truckAccessCheckedAt DateTime?
  /// Koordinatin snap edildigi kamyon yoluna mesafe (m); buyuk deger supheli geocode
  truckSnapDistanceM   Decimal?          @db.Decimal(8, 2)
  truckAccessNote      String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupAssignments   Assignment[] @relation("AssignmentPickupLocation")
  deliveryAssignments Assignment[] @relation("AssignmentDeliveryLocation")
  tourDepots          Tour[]       @relation("TourDepot")
  tourStops           TourStop[]   @relation("TourStopLocation")

  @@unique([tenantId, normalizedHash])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([tenantId, truckAccess])
}

/// Bir aracin bir gunluk sirali durak dizisi.
///
/// Tek alis + tek teslimden olusan uzun yol gorevi bunun ozel durumudur
/// (iki durak); ayri bir yapiya gerek yok. Assignment kaydi korunur — Tour
/// onun uzerine gecen bir planlama katmani, yerine gecen bir sey degil.
model Tour {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name      String?
  workDate  DateTime
  status    TourStatus @default(draft)
  vehicleId String?
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId  String?
  driver    Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)

  /// Turun baslangic/bitis noktasi. Bos ise ilk/son durak esas alinir.
  depotLocationId String?
  depotLocation   Location? @relation("TourDepot", fields: [depotLocationId], references: [id], onDelete: SetNull)

  /// Optimizasyon ciktisi. Gerceklesen degerlerle karsilastirmak icin
  /// saklanir — sapma raporunun tur duzeyindeki karsiligi.
  plannedDistanceKm  Decimal? @db.Decimal(12, 3)
  plannedDurationMin Int?
  plannedFuelLiters  Decimal? @db.Decimal(10, 3)
  /// Maut tahmini. Valhalla tutar hesaplamadigi icin kendi katmanimiz doldurur;
  /// hesaplanamadiginda null kalir ve rapor bunu "bilinmiyor" olarak gosterir.
  plannedTollCents   Int?

  /// Optimizasyon oncesi durum — kullaniciya "once/sonra" gostermek icin.
  /// Optimizasyon kabul edilmezse geri donulecek referans da budur.
  baselineDistanceKm  Decimal? @db.Decimal(12, 3)
  baselineDurationMin Int?

  optimizedAt       DateTime?
  /// Arka plan isinin kimligi; ayni tur icin ikinci is baslatilmasini engeller
  optimizationJobId String?
  /// Optimizasyon basarisiz olduysa kullaniciya gosterilecek sebep.
  /// Ornegin kamyona kapali bir durak tum turu cokertir.
  optimizationError String?

  createdById String
  createdBy   User     @relation("TourCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stops          TourStop[]
  workTimeEvents WorkTimeEvent[]

  @@index([tenantId])
  @@index([tenantId, workDate])
  @@index([tenantId, vehicleId, workDate])
  @@index([tenantId, driverId, workDate])
  @@index([tenantId, status])
}

/// Turdaki tek bir durak.
model TourStop {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  /// Yurutulecek sira. Optimizasyon bunu yeniden yazar.
  sequence        Int
  /// Kullanicinin girdigi ilk sira — optimizasyonun ne degistirdigini
  /// gostermek ve gerekirse geri donmek icin korunur.
  plannedSequence Int?

  kind       TourStopKind
  locationId String
  location   Location     @relation("TourStopLocation", fields: [locationId], references: [id], onDelete: Restrict)

  /// Durak bir gorevden turetildiyse baglantisi. Bos olabilir: depo duraklari
  /// ve serbest eklenen duraklar bir goreve ait degildir.
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  /// Musterinin kabul ettigi zaman araligi, "HH:MM". Repo genelinde saatler
  /// string tutuluyor (bkz. Assignment.startTime); ayni desen izlendi.
  windowStart    String?
  windowEnd      String?
  /// Durakta gecen sure (bosaltma, evrak). Cok durakli dagitimda planin
  /// buyuk bolumunu bu olusturur.
  serviceMinutes Int     @default(0)

  weightKg Decimal? @db.Decimal(10, 2)
  volumeM3 Decimal? @db.Decimal(10, 3)

  /// Optimizasyon ciktisi
  plannedArrivalAt   DateTime?
  plannedDepartureAt DateTime?
  /// Bir onceki duraktan bu duraga olan bacak
  legDistanceKm      Decimal?  @db.Decimal(12, 3)
  legDurationMin     Int?

  /// Yurutme kaydi. Planlama alanlarindan ayri: plan optimizasyonla yeniden
  /// yazilabilir, gerceklesen ise degismez.
  status             TourStopStatus @default(pending)
  arrivedAt          DateTime?
  completedAt        DateTime?
  /// Isaretleme anindaki telefon konumu. Sonradan "orada degildim" itirazi
  /// gelirse elimizde tek kanit bu.
  completedLatitude  Decimal?       @db.Decimal(10, 7)
  completedLongitude Decimal?       @db.Decimal(10, 7)
  /// Cevrimdisi kuyruk ayni isaretlemeyi baglanti gelince tekrar gonderebilir.
  /// Son uygulanan istemci olayinin kimligi; ayni kimlik yeniden gelirse islem
  /// tekrarlanmaz. Sira bozulmasina karsi ayrica durum gerilemesi engelleniyor
  /// (bkz. tour-stop.service).
  clientEventId      String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tourId, sequence])
  @@index([tenantId])
  @@index([tourId])
  @@index([tenantId, locationId])
  @@index([assignmentId])
}

model Assignment {
  id                   String           @id @default(cuid())
  tenantId             String           @default("default-tenant")
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId             String
