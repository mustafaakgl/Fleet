/**
 * ===========================================================================
 * Ordivan otomasyonu ve connector temeli (Faz 12)
 * TASARIM SINIRI: bu katman Fleet'in domain kayitlarina HIC YAZMAZ. Ciktisi
 * yalnizca bir ONERI (`AutomationProposal`) ve insanin verdigi karardir.
 * Onay bir Assignment, Tour, ServiceRecord ya da fatura URETMEZ.
 * ===========================================================================
 */

/// Connector'in yasam dongusu.
enum OrdivanConnectorStatus {
  /// Enrollment kodu uretildi, connector heniz kaydolmadi.
  pending_enrollment
  active
  /// Iptal edildi. Kayit SILINMEZ: hangi connector ne zaman is aldi sorusunun
  /// cevabi denetimde kalmali.
  revoked
}

/// Is yasam dongusu.
enum AutomationJobStatus {
  queued
  /// Bir connector kiraladi ama heniz calistirmaya baslamadi.
  leased
  running
  completed
  failed
  cancelled
  /// Deneme siniri doldu. Otomatik tekrar YOK; insan bakmali.
  dead_letter
}

enum AgentRunStatus {
  running
  completed
  failed
}

/// Oneri yasam dongusu.
enum AutomationProposalStatus {
  pending_review
  approved
  rejected
  /// Suresi doldu. Sessizce onaylanmis SAYILMAZ.
  expired
}

/// Insanin verdigi karar.
enum ApprovalDecision {
  approved
  rejected
}

/// Onay gorevinin durumu.
enum ApprovalTaskStatus {
  open
  decided
  /// Oneri suresi doldugu icin kapatildi. Karar VERILMEDI — bu, sessizce
  /// onaylanmis saymaktan tamamen farkli bir sonuc.
  closed_expired
}

/**
 * RED SEBEBI — sayilabilir olmali.
 * "Neden reddedildi" sorusunun cevabi serbest metinden okunamaz. Bu kategori
 * ajanin kalite sinyalidir: hangi hata turu yogunlasiyor, hangi prompt/model
 * hangi sebeple duzeltiliyor.
 */
enum AutomationRejectionCategory {
  /// Oneri yanlis kayda/varliga baglanmis.
  incorrect_match
  /// Baglanti dogru ama deger yanlis.
  incorrect_value
  duplicate
  /// Karar verecek kanit yok.
  insufficient_evidence
  /// Icerik guvenilmez ya da manipulasyon suphesi tasiyor.
  unsafe_or_untrusted
  /// Digerlerine girmiyor — ACIKLAMA ZORUNLU.
  other
}

/**
 * EVRENSEL UC DURUMLU KONTROL SEMANTIGI.
 * `unknown` HICBIR YERDE `verified` ya da "sorun yok" anlamina gelmez. Bir
 * kontrol calistirilamadiysa bunu soylemek zorundayiz; sessizce gecmek,
 * kontrol edilmis izlenimi verir. Bu enum butun gelecek ajanlarin ortak
 * sozlesmesi (bkz. automation-check.contract.ts).
 */
enum AutomationCheckStatus {
  verified
  failed
  unknown
}

/// Insanin oneriye ne yaptigi — SAYILABILIR olmali ki "kac oneri gercekten
/// duzeltildi" sorusu serbest metinden degil veriden cevaplanabilsin.
enum AutomationCorrectionCategory {
  /// Alan oldugu gibi kabul edildi.
  accepted_as_is
  /// Degeri insan degistirdi.
  value_corrected
  /// Ajanin hic uretmedigi alani insan ekledi.
  field_added
  /// Ajanin urettigi alani insan kaldirdi.
  field_removed
  /// Oneri butunuyle reddedildi.
  rejected_entirely
}

/**
 * Bir kiracinin makinesinde calisan Ordivan connector'u.
 * KIMLIK MODELI: connector kendi kiracisini ya da rolunu SECEMEZ. Enrollment
 * kodu tek kullanimlik ve kisa omurlu; kod hangi kiraciya aitse connector da
 * o kiraciya kilitlenir. Bu yuzden `tenantId` istemciden ASLA alinmaz.
 * SECRET DB'DE DUZ METIN DURMAZ: yalnizca SHA-256 ozeti ve gosterim icin
 * kirilmis bir onek saklanir. Duz metin yalnizca uretildigi ANDA, bir kez
 * doner (bkz. refresh-token.service.ts ile ayni desen).
 */
model OrdivanConnector {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Insanin ekranda tanidigi ad ("Buro-PC", "Werkstatt-Laptop").
  displayName String
  status      OrdivanConnectorStatus @default(pending_enrollment)

  /// --- Enrollment (tek kullanimlik, kisa omurlu) ---
  /// Kodun KENDISI degil ozeti. Kod da bir secret'tir.
  enrollmentCodeHash  String    @unique
  enrollmentExpiresAt DateTime
  /// Doluysa kod KULLANILMISTIR ve bir daha kabul edilmez.
  enrolledAt          DateTime?

  /// --- Credential ---
  credentialHash      String?   @unique
  /// Yalnizca ekranda "hangi anahtar" ayrimi icin ilk birkac karakter.
  credentialPrefix    String?
  credentialIssuedAt  DateTime?
  credentialRotatedAt DateTime?
  credentialRevokedAt DateTime?

  /**
   * Bu connector'in alabilecegi is turleri.
   * ARAC DEGIL, IS TURU: connector'a "genel SQL", "shell" ya da "keyfi HTTP"
   * gibi bir yetenek VERILEMEZ. Liste job type registry ile dogrulanir.
   */
  capabilities String[]

  /// --- Surum ve uyumluluk (connector kendisi bildirir) ---
  connectorVersion String?
  protocolVersion  String?
  platform         String?
  architecture     String?

  lastHeartbeatAt DateTime?

  createdById String
  createdBy   User     @relation("OrdivanConnectorCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs AutomationJob[]
  runs AgentRun[]

  /// Faz 14 — bu tarayicidan gelen belge yuklemeleri.
  documentIntakes DocumentIntake[]

  @@unique([tenantId, displayName])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("ordivan_connectors")
}

/**
 * Connector'a verilecek is.
 * KIRALAMA (lease) MODELI: is bir connector'a suresi belli bir sure icin
 * verilir. Sure dolarsa is geri kuyruga duser ve `attempt` artar. Eski
 * denemenin gec gelen sonucu YENISINI EZEMEZ — her deneme kendi
 * `leaseToken`ini tasir ve tamamlama bu token'la dogrulanir.
 */
model AutomationJob {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Registry'de tanimli olmayan bir tur kabul EDILMEZ.
  jobType       String
  /// Payload bu surumun semasiyla dogrulanir.
  schemaVersion Int    @default(1)
  payload       Json

  /// Isi alabilmek icin gereken yetenek. Connector'da yoksa is verilmez.
  requiredCapability String

  status AutomationJobStatus @default(queued)

  /// --- Kiralama ---
  leasedByConnectorId String?
  leasedByConnector   OrdivanConnector? @relation(fields: [leasedByConnectorId], references: [id], onDelete: SetNull)
  leasedAt            DateTime?
  leaseExpiresAt      DateTime?
  /// Aktif denemenin kimligi. Tamamlama/hata bildirimi bunu tasimak zorunda;
  /// eslesmiyorsa BAYAT bir denemedir ve sessizce reddedilir.
  leaseToken          String?

  attempt     Int @default(0)
  maxAttempts Int @default(3)

  completedAt    DateTime?
  failedAt       DateTime?
  deadLetteredAt DateTime?
  /// Teknik hata SINIFI, saglayici mesaji degil.
  failureClass   String?

  /// Isin uzerinde calistigi belge (Faz 13). Her isin belgesi olmak zorunda
  /// DEGIL: `system.echo` gibi turler belgesiz calisir.
  documentId String?
  document   AutomationDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?    @relation("AutomationJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs      AgentRun[]
  proposals AutomationProposal[]

  @@index([tenantId])
  /// Kiralama sorgusunun canonical yolu: kiraci + durum + en eski once.
  @@index([tenantId, status, createdAt])
  @@index([leasedByConnectorId])
  @@index([status, leaseExpiresAt])
  @@index([documentId])
  @@map("automation_jobs")
}

/**
 * Tek bir DENEME. Is yeniden kiralandiginda yeni bir run acilir.
 * NEDEN AYRI KAYIT: "bu sonucu hangi connector, hangi yetki kapsamiyla, hangi
 * arac setiyle uretti" sorusunun cevabi isin ustune yazilsaydi ikinci deneme
 * birincinin izini silerdi.
 */
model AgentRun {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  jobId       String
  job         AutomationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  connectorId String
  connector   OrdivanConnector @relation(fields: [connectorId], references: [id], onDelete: Restrict)

  attempt Int
  status  AgentRunStatus @default(running)

  /// --- Denetlenebilir yetki izi ---
  /// Bu kosuda GECERLI olan kapsam, yetenek ve arac seti. Sonradan connector
  /// yetkisi degisse bile bu kosunun neyle calistigi degismez.
  credentialScope String[]
  capabilities    String[]
  toolset         String[]

  connectorVersion String?
  protocolVersion  String?

  /// Uretim tarafinin surumleri — duzeltme analizinin karsilastirma ekseni.
  modelVersion  String?
  promptVersion String?
  schemaVersion Int?

  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  failureClass String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals AutomationProposal[]

  /// Bir is icin ayni deneme numarasi iki kez acilamaz.
  @@unique([jobId, attempt])
  @@index([tenantId])
  @@index([connectorId, startedAt])
  @@map("agent_runs")
}

/**
 * Ajanin URETTIGI ONERI. Bir domain kaydi DEGILDIR.
 * `payload` runtime sema dogrulamasindan gecmis, beklenmeyen alanlari
 * REDDEDILMIS veridir. Ham model metni buraya girmez.
 */
model AutomationProposal {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  jobId      String
  job        AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentRunId String
  agentRun   AgentRun      @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  /// Whitelist'te olmayan bir tur kabul EDILMEZ.
  proposalType  String
  schemaVersion Int    @default(1)

  status AutomationProposalStatus @default(pending_review)

  /// Dogrulanmis oneri govdesi.
  payload    Json
  /// Alan basina guven skoru: { alan: 0..1 }.
  confidence Json?
  /// Kanit: neyin nereden geldigi. Ham belge/OCR metni KOPYALANMAZ.
  evidence   Json?
  /**
   * Uc durumlu kontroller: [{ code, status, dataAt, reason }].
   * `unknown` burada da "sorun yok" DEMEK DEGILDIR.
   */
  checks     Json?

  /// Suresi dolan oneri otomatik onaylanmaz, `expired` olur.
  expiresAt DateTime?

  /**
   * Onay sonucu olusan CANONICAL kayit (Faz 13).
   * `@unique`: bir oneri EN FAZLA BIR ServiceRecord uretebilir ve bir
   * ServiceRecord en fazla bir oneriye ait olabilir. Tekrarlanan ya da
   * eszamanli onayin ikinci bir maliyet satiri yaratmasi VERITABANINDA
   * imkansiz — uygulama kontrolu tek basina yeterli olmazdi.
   * PARALEL MODEL YOK: olusan kayit repodaki `ServiceRecord`; bu alan yalnizca
   * izlenebilirlik bagi.
   */
  resultServiceRecordId String?        @unique
  resultServiceRecord   ServiceRecord? @relation("ServiceRecordFromProposal", fields: [resultServiceRecordId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 1:n — gelecekte cok adimli onaya (ornegin once ofis, sonra muhasebe)
  /// izin vermek icin. FAZ 12'DE tek gorev olusturuluyor; iliskiyi simdiden
  /// 1:n yapmak, ileride veri tasimadan adim eklenebilmesi demek.
  approvalTasks    ApprovalTask[]
  correctionEvents AutomationCorrectionEvent[]

  @@index([tenantId])
  @@index([tenantId, status, createdAt])
  @@index([jobId])
  @@map("automation_proposals")
}

/**
 * Insanin is kalemi — inceleme metriklerinin tasiyicisi.
 * NEDEN ONERIDEN AYRI: oneri makinenin ciktisi, bu kayit insanin davranisi.
 * Ikisini tek satirda birlestirmek, "ne kadar surede karar verildi" gibi
 * olculeri onerinin her guncellenmesinde bulaniklastirirdi.
 * OLCUM AMACI RUBBER-STAMPING RISKI. Gizli fare/klavye takibi YOK: yalnizca
 * acilis ani, karar ani ve degistirilen alan sayisi tutulur.
 */
model ApprovalTask {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  proposalId String
  proposal   AutomationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  /// Cok adimli onayda adimin sirasi. Faz 12'de her zaman 1.
  sequence Int                @default(1)
  status   ApprovalTaskStatus @default(open)

  /// --- Atama ---
  /// Gorev bir ROLE ya da belirli bir KULLANICIYA atanabilir. Ikisi de bossa
  /// yetkili herkes gorur (Faz 12'nin davranisi).
  assignedRole   String?
  assignedUserId String?
  assignedUser   User?   @relation("ApprovalTaskAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)

  /// Oneri ilk kez ACILDIGI an. Karar suresinin baslangici bu.
  openedAt DateTime?

  decision          ApprovalDecision?
  decidedById       String?
  decidedBy         User?                        @relation("ApprovalTaskDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  /**
   * Insan aciklamasi. HTML olarak RENDER EDILMEZ.
   * NORMAL ONAYDA OPSIYONEL: her rutin onay icin metin istemek, insanlari
   * anlamsiz doldurmaya iter ve gercekten aciklama gereken yerde de ayni
   * refleksle "ok" yazilir. Zorunluluk yalnizca karar gercekten aciklama
   * gerektirdiginde devreye giriyor (bkz. automation-proposal.service).
   */
  decisionNote      String?
  /// Red sebebi — reddederken ZORUNLU.
  rejectionCategory AutomationRejectionCategory?

  /// openedAt -> decidedAt farki. Turetilebilir ama raporun her satir icin
  /// hesap yapmamasi icin yaziliyor.
  reviewDurationMs              Int?
  /// Insanin gercekten degistirdigi alan sayisi.
  changedFieldCount             Int     @default(0)
  /// Kritik ve dusuk guvenli alanlarin insan tarafindan dogrulanip
  /// dogrulanmadigi — rubber-stamping'in en dogrudan gostergesi.
  criticalLowConfidenceVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  correctionEvents AutomationCorrectionEvent[]

  /// Ayni oneride ayni sira iki kez acilamaz.
  @@unique([proposalId, sequence])
  @@index([tenantId])
  @@index([tenantId, decidedAt])
  @@index([proposalId])
  @@index([tenantId, status])
  @@map("approval_tasks")
}

/**
 * Insanin bir ALAN uzerinde ne yaptigi.
 * HASSAS DEGER TASIMAZ. Belgeden okunan tutar, ad, plaka gibi degerler burada
 * TEKRARLANMAZ: bu tablo analitik icin var ve kisisel/mali veriyi ikinci bir
 * yere kopyalamak, silme ve saklama politikasini iki katina cikarirdi. Degerin
 * kendisi gerekiyorsa `proposalId` uzerinden onerinin kendisine gidilir.
 */
model AutomationCorrectionEvent {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  proposalId     String
  proposal       AutomationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approvalTaskId String
  approvalTask   ApprovalTask       @relation(fields: [approvalTaskId], references: [id], onDelete: Cascade)

  /// Alanin ADI ve TURU — degeri degil.
  fieldName String
  fieldType String

  changed           Boolean
  category          AutomationCorrectionCategory
  /// Red sebebi — yalnizca reddedilen onerilerde dolu.
  rejectionCategory AutomationRejectionCategory?

  /// Ajanin bu alan icin bildirdigi guven (0..1). Duzeltmelerin dusuk guvenli
  /// alanlarda yogunlasip yogunlasmadigi buradan olculur.
  previousConfidence Decimal? @db.Decimal(4, 3)

  /// Kritik ve dusuk guvenli bir alanin insan tarafindan dogrulanip
  /// dogrulanmadigi.
  criticalLowConfidence Boolean @default(false)
  verifiedByReviewer    Boolean @default(false)

  /// Uretim tarafinin surumleri — "hangi prompt/model daha az duzeltiliyor".
  modelVersion  String?
  promptVersion String?
  schemaVersion Int?

  /// Bu alanin karar aninda gecen inceleme suresi (gorev duzeyinde).
  reviewDurationMs Int?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([proposalId])
  @@index([approvalTaskId])
  @@index([tenantId, category, createdAt])
  @@map("automation_correction_events")
}

// ============================================================================
// FAZ 14 — AKILLI BELGE GELEN KUTUSU
// ============================================================================

/**
 * Belgenin Fleet'e GIRDIGI kanal.
 *
 * Kapali bir kume: kanal eklemek protokol isidir, veri girisi degil. Belge
 * TURLERI aksine buyuyen bir kume oldugu icin enum DEGIL, registry ile
 * dogrulanan surumlu anahtar kullaniyor (bkz. core/document-type-registry.ts).
 */
enum DocumentIntakeSource {
  /// Buro web arayuzu.
  web
  /// Mobil tarayici — kamera ya da dosya.
  mobile
  /// Faz 12 connector protokolu uzerinden tarayici.
  connector
}

/// Fiziksel yuklemenin yasam dongusu.
enum DocumentIntakeStatus {
  /// Siniflandirma suruyor.
  processing
  /// En az bir mantiksal belge insan kararini bekliyor.
  needs_review
  /// Butun mantiksal belgeler sonuclandi.
  settled
  /// Isleme alinamadi (bozuk/sifreli dosya, sayfa sayilamadi).
  failed
}

/// Mantiksal belgenin yasam dongusu.
enum IntakeDocumentStatus {
  classifying
  needs_review
  /**
   * Tur DOGRU ama canonical modele guvenli esleme yapilamiyor — ornegin yakit
   * fisinde surucu belirlenemedi. PARALEL MODEL UYDURULMAZ: belge burada
   * bekler ve raporda gorunur.
   */
  needs_domain_review
  routed
  rejected
  failed
}

/// Sunucu tarafi arac eslestirmesinin sonucu. `unknown` "sorun yok" DEMEK DEGILDIR.
enum IntakeVehicleMatchStatus {
  verified
  failed
  unknown
}

/**
 * FIZIKSEL YUKLEME (Faz 14).
 *
 * Bir yukleme = bir dosya = bir `AutomationDocument` (blob). Blob Faz 13'ten
 * GENELLESTIRILEREK yeniden kullaniliyor; ikinci bir dosya deposu ya da ayri
 * bir servis-faturasi saklama sistemi KURULMADI.
 *
 * ORIJINAL DEGISMEZ: hash, boyut ve dosyanin kendisi bu kayittan sonra hicbir
 * akista yeniden yazilmaz. Bolme, birlestirme ve yeniden siniflandirma
 * yalnizca mantiksal belgeleri degistirir — dosya KOPYALANMAZ.
 */
model DocumentIntake {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Degismez blob. Ayni blob birden fazla yuklemeye baglanabilir mi? HAYIR:
  /// kiraci icinde hash tekil oldugu icin ikinci yukleme var olan girisi doner.
  artifactId String
  artifact   AutomationDocument @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  source DocumentIntakeSource
  status DocumentIntakeStatus @default(processing)

  /// Sunucunun DOSYADAN saydigi sayfa sayisi. Istemcinin bildirdigi deger degil.
  pageCount Int @default(1)

  /**
   * Connector yuklemesinin idempotency anahtari.
   *
   * Tarayici ayni belgeyi aglar koptugunda yeniden gonderir. Anahtar kiraci
   * icinde tekil: ikinci gonderim YENI bir gelen kutusu girdisi ACMAZ.
   */
  idempotencyKey String?

  /// Web/mobil yuklemede kullanici, connector yuklemesinde `null`.
  uploadedById String?
  uploadedBy   User?   @relation("DocumentIntakeUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// Connector yuklemesinde tarayici, aksi halde `null`.
  connectorId String?
  connector   OrdivanConnector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  /// Siniflandirmayi ureten mock surumu — duzeltme analizinin karsilastirma ekseni.
  classifierVersion String?
  /// Teknik hata SINIFI, saglayici mesaji degil.
  failureClass      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents IntakeDocument[]

  /// Kiraci ICINDE tekil. Kiracilar arasinda anahtar CAKISABILIR ve sizmaz.
  @@unique([tenantId, idempotencyKey])
  /**
   * BIR BLOB = BIR GIRDI.
   *
   * Tekillik uygulamada degil VERITABANINDA: iki istek ayni dosyayi AYNI ANDA
   * yukledigi zaman ikisi de "bu hash yok" gorur ve ikisi de yazmaya calisir.
   * Uygulama kontrolu bu yarisi kaybeder; bu kisit kaybetmez.
   */
  @@unique([artifactId])
  @@index([tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, source, createdAt])
  @@map("document_intakes")
}

/**
 * MANTIKSAL BELGE = ayni blob + SAYFA ARALIGI (Faz 14).
 *
 * NEDEN AYRI TABLO: taranmis bir yigin, ic ice gecmis birden fazla belge
 * tasiyabilir. Bunlari ayri dosyalara bolmek orijinalin butunlugunu ve
 * hash'ini yok ederdi. Bolme/birlestirme burada olur, DOSYAYA DOKUNULMAZ.
 *
 * AJANIN ILK CIKTISI DEGISMEZ (Faz 13 sozlesmesi): `proposed*` alanlari
 * yazildiktan sonra HICBIR akista guncellenmez. Insanin karari `typeKey`,
 * `pageFrom/pageTo` ve `vehicleId` alanlarinda durur. Ikisi ayni alanda
 * dursaydi "model mi yanildi yoksa insan mi degistirdi" sorusunun cevabi
 * olmazdi.
 */
model IntakeDocument {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  intakeId String
  intake   DocumentIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  // --- AJANIN ILK CIKTISI — DEGISMEZ ---
  /// Registry ile dogrulanan SURUMLU anahtar (ornegin `service_invoice@v1`).
  /// Prisma enum DEGIL: belge turleri buyuyen bir kume.
  proposedTypeKey     String
  proposedConfidence  Decimal? @db.Decimal(4, 3)
  proposedPageFrom    Int
  proposedPageTo      Int
  /// Muayene alt turu: `tuv | sp | unknown`.
  proposedSubtype     String?
  /// Neyin nereden geldigi. HAM OCR METNI KOPYALANMAZ.
  evidence            Json?
  /// Plaka/VIN/tarih/tutar ADAYLARI. Ajan `vehicleId` BELIRLEYEMEZ.
  candidates          Json?
  /// Uc durumlu kontroller: [{ code, status, ... }].
  checks              Json?
  /// Ajanin sayfa sinirlarina guvenildi mi (ortusen/tasan oneri `false`).
  segmentationTrusted Boolean  @default(false)

  // --- INSANIN KARARI ---
  typeKey  String
  subtype  String?
  pageFrom Int
  pageTo   Int

  status IntakeDocumentStatus @default(classifying)

  /**
   * Arac SUNUCUDA cozulur: tam VIN → tam plaka. Ajan bu alani DOLDURAMAZ.
   */
  vehicleId         String?
  vehicle           Vehicle?                  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleMatchStatus IntakeVehicleMatchStatus @default(unknown)

  /// Yakit fisi icin ZORUNLU: `FleetFuelEntry.driverId` NOT NULL. Belgeden
  /// surucu OKUNMAZ — insan seciyor. Secilmediyse belge `needs_domain_review`.
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  assignedUserId String?
  assignedUser   User?   @relation("IntakeDocumentAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)

  decidedById String?
  decidedBy   User?     @relation("IntakeDocumentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  /// Red sebebi — reddederken ZORUNLU, kullaniciya gosterilir.
  rejectionReason String?
  /// `needs_domain_review` sebebi — raporda gorunur.
  domainReviewReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routing IntakeDocumentRouting?

  @@index([tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, typeKey, createdAt])
  @@index([intakeId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([assignedUserId])
  @@map("intake_documents")
}

/**
 * YONLENDIRME — EXACTLY-ONCE (Faz 14).
 *
 * `intakeDocumentId` TEKIL: bir mantiksal belge EN FAZLA BIR canonical kayit
 * uretebilir. Bu kural uygulamada degil VERITABANINDA, cunku cift tiklama ve
 * eszamanli iki incelemeci uygulama kontrolunu gecebilir — Faz 13'teki
 * `AutomationProposal.resultServiceRecordId` ile ayni desen.
 *
 * `[tenantId, entityType, entityId]` de TEKIL: ayni canonical kayda iki farkli
 * belge baglanamaz. Ikinci bir baglanti, sessizce olusmus bir cift kaydin en
 * dogrudan isaretidir.
 *
 * PARALEL MODEL YOK: `entityType/entityId` repodaki MEVCUT kayitlari gosterir
 * (`ServiceRecord`, `FleetFuelEntry`, `Document`, `Fine`); bu tablo yalnizca
 * izlenebilirlik bagi ve tekillik tasiyicisidir.
 */
model IntakeDocumentRouting {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  intakeDocumentId String         @unique
  intakeDocument   IntakeDocument @relation(fields: [intakeDocumentId], references: [id], onDelete: Cascade)

  /// Registry ile dogrulanan hedef anahtari.
  destination String

  entityType String
  entityId   String

  /// Yan etki kaydi — ornegin muayene belgesinden turetilen hatirlatma.
  /// TASLAK/ONERI: kullanici acikca onayladiysa olusur.
  secondaryEntityType String?
  secondaryEntityId   String?

  routedById String?
  routedBy   User?    @relation("IntakeDocumentRoutedBy", fields: [routedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId])
  @@index([tenantId, destination, createdAt])
  @@map("intake_document_routings")
}

// ============================================================================
// FAZ 15 — CANONICAL TRANSPORT ORDER
// ============================================================================

/// Ticari yasam dongusu. OPERASYON DURUMU DEGIL: bir sipariş `confirmed` iken
/// hic planlanmamis olabilir. Ikisini karistirmak, "onaylandi" ile "yola cikti"
/// arasindaki farki yok eder.
enum TransportOrderStatus {
  draft
  confirmed
  /// Silinmez. Iptal bir OLAYDIR ve gecmisi korunur.
  cancelled
}

/// Faturalamanin neye dayandigi.
enum TransportOrderBillingMode {
  /// Butun gerekli teslimatlar dogrulanmadan fatura hazir DEGIL.
  on_order_completion
  /// Yalnizca dogrulanmis dilim fatura adayi olur.
  per_delivery
}

/**
 * Siparişin nereden geldigi.
 *
 * Faz 15'te tek deger: `manual`. Faz 16'da e-posta/ajan kaynaklari eklenecek —
 * ama o kaynaklar da siparişi DOGRUDAN guncelleyemeyecek, yalnizca
 * `pending_review` bir revizyon onerebilecek.
 */
enum TransportOrderSource {
  manual
}

/**
 * Tehlikeli madde durumu.
 *
 * `unknown` HICBIR YERDE guvenli ya da uygun sayilmaz: "bilmiyorum" ile "hayir"
 * arasindaki fark, yanlis araca yuklenen bir ADR sevkiyati kadar buyuk.
 */
enum AdrStatus {
  yes
  no
  unknown
}

enum TransportOrderRevisionStatus {
  /// Ana kayda UYGULANMIS revizyon.
  applied
  /// Onaylanmis siparişte yapilan degisiklik onerisi. Ana kayit DEGISMEDI.
  pending_review
  /// Reddedildi. Ana kayit DEGISMEDI ve oneri gecmiste kalir.
  rejected
}

/// Iptal sebebi — serbest metinden degil sayilabilir bir kategoriden.
enum TransportOrderCancellationCategory {
  customer_cancelled
  duplicate_order
  created_in_error
  no_capacity
  price_disagreement
  other
}

/**
 * MUSTERIDEN GELEN TICARI SIPARIS (Faz 15).
 *
 * `TransportRequest` ILE KARISTIRILMAZ: o bir SOFOR talebidir (iç planlama),
 * bu bir MUSTERI siparisi. Ikinci bir siparis modeli kurulmadi; ikisi farkli
 * gercekleri temsil ediyor (bkz. docs/ordivan-domain-mapping.md).
 *
 * OPERASYONA `Assignment` UZERINDEN BAGLANIR. `Tour` ile dogrudan bagi YOKTUR
 * ve `TourStop.transportOrderId` BILINCLI OLARAK EKLENMEDI: siparis-tur
 * iliskisi `Assignment` uzerinden zaten turetilebiliyor ve ikinci bir yol
 * acmak, "bu durak hangi siparise ait" sorusunu iki kaynaktan cevaplanabilir
 * hale getirirdi.
 */
model TransportOrder {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Musteri. Repodaki canonical musteri kaydi `Company`.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// Kiraci icinde benzersiz siparis numarasi.
  orderNumber String
  /// Musterinin KENDI referansi. Bizim numaramiz degil; musteriyle yazisirken
  /// kullanilan sey bu.
  externalReference String?

  /**
   * DUPLICATE TASIYICI.
   *
   * `{companyId}:{externalReference}` — yalnizca referans doluysa ve siparis
   * IPTAL EDILMEMISSE yaziliyor; aksi halde `null`. Tekillik uygulamada degil
   * VERITABANINDA: ayni referansi iki istek ayni anda gonderdiginde uygulama
   * kontrolu yarisi kaybeder. Repodaki `fuelingIntentSettledKey` ile ayni
   * desen.
   *
   * Iptal edilen siparis referansi SERBEST BIRAKIR: musteri ayni referansla
   * yeniden siparis verebilmeli.
   */
  duplicateKey String?

  orderDate DateTime

  /// Para birimi ZORUNLU ve EUR VARSAYILMAZ.
  currency String
  /// Sozlesme geliri. API'de STRING olarak doner — float yuvarlamasi bir
  /// sozlesme tutarini sessizce degistirmemeli.
  contractedRevenue Decimal? @db.Decimal(12, 2)

  billingMode TransportOrderBillingMode @default(on_order_completion)
  status      TransportOrderStatus     @default(draft)
  source      TransportOrderSource     @default(manual)

  /// Guncel revizyon numarasi. `TransportOrderRevision` ile birlikte artar.
  currentRevision Int @default(1)

  notes String?

  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("TransportOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  /// --- Iptal. Kayit SILINMEZ. ---
  cancelledAt          DateTime?
  cancelledById        String?
  cancelledBy          User?                              @relation("TransportOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationCategory TransportOrderCancellationCategory?
  cancellationNote     String?

  createdById String
  createdBy   User     @relation("TransportOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  /// OPTIMISTIC CONCURRENCY tasiyicisi — repodaki canonical desen
  /// (`expectedUpdatedAt + kosullu updateMany`, bkz. automation-proposal.service).
  updatedAt   DateTime @updatedAt

  consignments Consignment[]
  assignments  Assignment[]
  revisions    TransportOrderRevision[]

  @@unique([tenantId, orderNumber])
  /// Kiraci ICINDE tekil. Kiracilar arasinda ayni referans CAKISABILIR ve sizmaz.
  @@unique([tenantId, duplicateKey])
  @@index([tenantId])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, companyId, orderDate])
  @@map("transport_orders")
}

/**
 * SIPARISIN TASIMA KALEMI (Faz 15).
 *
 * Bir siparis bir ya da birden fazla kalem icerir. Bolunmus siparis birden
 * fazla `Assignment` uretir; kalem bunun ticari karsiligi.
 */
model Consignment {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  transportOrderId String
  transportOrder   TransportOrder @relation(fields: [transportOrderId], references: [id], onDelete: Cascade)

  /// Siparis icindeki sira. Kullaniciya gosterilen numara.
  sequence Int

  /// --- Yukleme ---
  pickupAddress     String
  pickupLocationId  String?
  pickupLocation    Location? @relation("ConsignmentPickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull)
  pickupWindowStart DateTime?
  pickupWindowEnd   DateTime?

  /// --- Bosaltma ---
  deliveryAddress     String
  deliveryLocationId  String?
  deliveryLocation    Location? @relation("ConsignmentDeliveryLocation", fields: [deliveryLocationId], references: [id], onDelete: SetNull)
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?

  cargoDescription String
  /// Miktar ve birim. Birim SERBEST metin degil ama repoda canonical bir
  /// birim enum'u yok; kisa metin olarak tutuluyor.
  quantity Decimal? @db.Decimal(12, 3)
  unit     String?

  weightKg    Decimal? @db.Decimal(12, 2)
  volumeM3    Decimal? @db.Decimal(12, 3)
  palletCount Int?

  /// `unknown` GUVENLI SAYILMAZ — planlama ekrani bunu acikca isaretler.
  adrStatus AdrStatus @default(unknown)

  /// Sicaklik araligi — yalnizca gerekiyorsa dolu.
  temperatureMinC Decimal? @db.Decimal(5, 2)
  temperatureMaxC Decimal? @db.Decimal(5, 2)

  shipperReference  String?
  consigneeReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]

  @@unique([transportOrderId, sequence])
  @@index([tenantId])
  @@index([transportOrderId])
  @@map("consignments")
}

/**
 * SIPARIS REVIZYONU — APPEND-ONLY (Faz 15).
 *
 * ESKI REVIZYON HICBIR ZAMAN YENIDEN YAZILMAZ. Her olusturma/degisiklik
 * degismez bir anlik goruntu birakir; "musteri ne zaman ne istedi" sorusunun
 * cevabi bu tabloda durur.
 *
 * ONAYLANMIS SIPARISTE degisiklik once `pending_review` olur ve ana kayit
 * DEGISMEZ. Kullanici eski/yeni degerleri karsilastirir; onay uygulanir, red
 * ana kaydi degistirmez.
 *
 * AJAN CIKTISI (Faz 16) BU KAPIDAN GECER: doğrudan siparişi guncelleyemez,
 * yalnizca `pending_review` bir revizyon onerebilir.
 */
model TransportOrderRevision {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  transportOrderId String
  transportOrder   TransportOrder @relation(fields: [transportOrderId], references: [id], onDelete: Cascade)

  /// Siparis kapsaminda DETERMINISTIK artar. Tekillik veritabaninda:
  /// eszamanli iki revizyon ayni numarayi ALAMAZ.
  revisionNumber Int

  status TransportOrderRevisionStatus @default(applied)

  /**
   * DEGISMEZ anlik goruntu: siparisin ve kalemlerinin o andaki hali.
   * Yazildiktan sonra hicbir akista guncellenmez.
   */
  snapshot Json

  /// Neyin degistigi: [{ field, before, after }]. Kullanici karsilastirmasi
  /// bunun uzerinden yapiliyor — arayuzun iki snapshot'i diff'lemesi gerekmiyor.
  changedFields Json?

  /// Faz 16 icin: uretimin kaynagi ve surumu.
  source        TransportOrderSource @default(manual)
  sourceVersion String?

  createdById String?
  createdBy   User?    @relation("TransportOrderRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  decidedById     String?
  decidedBy       User?     @relation("TransportOrderRevisionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  rejectionReason String?

  @@unique([transportOrderId, revisionNumber])
  @@index([tenantId])
  @@index([transportOrderId, createdAt])
  @@index([tenantId, status])
  @@map("transport_order_revisions")
}
