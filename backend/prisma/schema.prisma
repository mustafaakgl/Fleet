  vehicleId           String?
  vehicle             Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  dddFileId           String?
  dddFile             DddFile?              @relation(fields: [dddFileId], references: [id], onDelete: SetNull)
  type                TachoInfringementType
