/// Bir turun yasam dongusu. `optimizing` kisa suren bir gecis durumu:
/// mesafe matrisi 40 durak icin ~7 sn surdugu icin optimizasyon arka plan
/// isinde calisir ve bu sirada tur kilitli sayilir.
enum TourStatus {
  draft
  optimizing
  optimized
  released
  in_progress
  completed
  cancelled
}

/// Bir duragin ne icin durdugu. depot_start/depot_end turun baslangic ve
/// bitis noktasi; arac genelde depoya doner ve bu bacak da maliyete girer.
enum TourStopStatus {
  pending
  arrived
  completed
  skipped
}

enum TourStopKind {
  depot_start
  pickup
  delivery
  depot_end
}

