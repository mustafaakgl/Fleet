  vehicleId     String
  driverId      String?
  /// Servisin baslangici. Opsiyonel: mevcut kayitlarda yok ve tek gunluk
  /// islerde girilmesi zorunlu degil. `date` tamamlanma tarihidir.
  startDate     DateTime?
  date          DateTime
  serviceType   String
  vendor        String?
  repairCompany String
  costAmount    Decimal   @db.Decimal(10, 2)
  /// Tutarin para birimi. Faz 7.1 oncesi bu alan YOKTU ve tutarlar ortuk
