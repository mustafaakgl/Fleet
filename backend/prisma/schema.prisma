/// Fisin IS AKISI durumu. OCR'in TEKNIK durumuyla karistirilmamali: OCR
/// basarisiz olsa bile fis kaybolmaz, surucu formu elle doldurup gonderebilir.
///
/// MALIYET KURALI: yalnizca `approved` kayitlar arac maliyeti, TCO ve yakit
/// analitigine girer. Bekleyen fisler ayri gosterilebilir ama onaylanmis
/// maliyete EKLENMEZ.
enum FuelEntryWorkflowStatus {
  /// Yuklendi; surucu OCR taslagini kontrol ediyor. Mali alanlar bos olabilir.
  driver_review
  /// Surucu degerleri dogruladi. Surucu artik degistiremez.
  submitted
  /// Muhasebe onayladi. RAPORLARA GIREN TEK DURUM.
  approved
  /// Muhasebe reddetti. Maliyete girmez.
  rejected
}

/// OCR'in TEKNIK durumu. Is akisindan bagimsiz: `succeeded` fisin gonderildigi
/// anlamina gelmez, `failed` de fisin gecersiz oldugu anlamina gelmez.
enum FuelReceiptOcrStatus {
  not_requested
  processing
  succeeded
  failed
}

/// Yakit islemi — sistemdeki CANONICAL kayit.
///
/// NEDEN PARALEL MODEL YOK: fis yukleme, OCR ve surucu dogrulamasi bu modelin
/// uzerine kuruldu. Ayri bir FuelReceipt/FuelExpense tablosu ayni gercegi iki
/// yerde tutar ve raporlarin hangisini saydigini belirsiz birakirdi. Faz 5
/// raporundaki `FuelReceipt.fuelingIntentId` ifadesi bir model karari DEGILDI.
///
/// UPLOAD-FIRST: surucu once fisin fotografini yukluyor, degerler sonra
/// geliyor. Bu yuzden `liters` ve `totalCost` artik NULLABLE — yuklendigi anda
/// gercekten bilinmiyorlar ve 0 yazmak "bedava yakit" demek olurdu. `submitted`
/// durumuna gecmeden once ikisi de zorunlu.
///
/// `enteredAt` BILINCLI olarak NOT NULL kaldi: indeksli ve repo genelinde
/// orderBy/where'de kullaniliyor (telematik, bakim, sapma raporu). Nullable
/// yapmak onlarca sorguyu bozardi. Yuklemede `now()` yazilir, surucu confirm'de
/// fisteki gercek tarihi girer.
model FleetFuelEntry {
  id                String   @id @default(cuid())
  tenantId          String   @default("default-tenant")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId         String
  driverId          String
  enteredAt         DateTime
  liters            Decimal? @db.Decimal(10, 3)
  /// YAKIT satirinin brut toplami — fisin genel toplami DEGIL. Karma fiste
  /// (kahve, market, arac yikama) genel toplami buraya yazmak aracin yakit
  /// maliyetini sisirir; genel toplam `receiptGrossAmount`'ta durur.
  totalCost         Decimal? @db.Decimal(12, 2)
  currency          String   @default("EUR")
  odometerKm        Decimal? @db.Decimal(12, 3)
  isFullTank        Boolean  @default(false)
  receiptStoredPath String?
  receiptMimeType   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// --- Is akisi ---
  workflowStatus FuelEntryWorkflowStatus @default(driver_review)
  submittedAt    DateTime?

  /// --- Surucunun ONAYLADIGI canonical fis alanlari ---
  stationName        String?
  stationAddress     String?
  receiptNumber      String?
  fuelProduct        FuelProductType?
  pricePerLiter      Decimal?         @db.Decimal(10, 4)
  receiptGrossAmount Decimal?         @db.Decimal(12, 2)
  receiptNetAmount   Decimal?         @db.Decimal(12, 2)
  receiptVatAmount   Decimal?         @db.Decimal(12, 2)
  receiptVatRate     Decimal?         @db.Decimal(5, 2)
  paymentMethod      String?
  /// Fiste plaka yaziyorsa. Aracin plakasi DEGIL — karsilastirma icin.
  receiptPlateNumber String?

  /// --- Yakit uyumlulugu istisnasi ---
  /// Fisteki urun aracin onayli listesinde degil. Kayit YOK EDILMEZ; surucunun
  /// acik onayiyla muhasebe incelemesine gider.
  compatibilityMismatch       Boolean   @default(false)
  compatibilityAcknowledgedAt DateTime?

  /// --- Dosya guvenligi ---
  /// SHA-256. Ayni kiraci icinde birebir ayni dosya iki kez yuklenemez.
  receiptFileHash     String?
  receiptFileSize     Int?
  receiptOriginalName String?

  /// --- OCR ---
  ocrStatus          FuelReceiptOcrStatus @default(not_requested)
  ocrProvider        String?
  ocrProviderVersion String?
  ocrProcessedAt     DateTime?
  /// Normalize edilmis snapshot: alan basina { value, confidence }. HAM
  /// saglayici cevabi, base64 resim ya da tam OCR metni BURAYA YAZILMAZ.
  ocrExtraction      Json?
  /// Teknik olmayan hata SINIFI (ornegin 'unreadable'), saglayici mesaji degil.
  ocrErrorClass      String?
  /// Verinin gercek mi demo mu oldugu — istemci kendi env'inden tahmin etmez.
  ocrDataMode        String?

  /// --- Muhasebe incelemesi (Faz 7) ---
  /// Onay AYRI BIR MALIYET SATIRI URETMIYOR: is akisi durumu bu kayitta
  /// duruyor ve maliyet sorgusu dogrudan onu filtreliyor. Ikinci bir "onay"
  /// ya da "gider" tablosu, hangi satirin gercek oldugunu belirsiz birakirdi.
  ///
  /// GECMIS icin de paralel model YOK: AuditLog kiraci kapsamli ve
  /// entityType + entityId + action ile sorgulanabiliyor, review zaman
  /// cizelgesi oradan okunuyor. Asagidakiler yalnizca SON durumun ozeti —
  /// ekranda gostermek ve her satir icin denetim tablosuna gitmemek icin.
  reviewedById    String?
  reviewedBy      User?     @relation("FuelEntryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Son inceleme ani (onay ya da ret).
  reviewedAt      DateTime?
  /// Muhasebenin onaydaki opsiyonel notu. HTML olarak RENDER EDILMEZ.
  accountingNote  String?
  /// SON ret nedeni — surucuye gosterildigi icin zorunlu ve okunabilir.
  /// Yeniden gonderimde SILINMIYOR: surucu neyi duzeltmesi gerektigini
  /// gormeye devam etmeli.
  rejectionReason String?
  rejectedAt      DateTime?
  /// Surucunun ret sonrasi yeniden gonderme ani.
  resubmittedAt   DateTime?

  /// --- Yakit niyeti bagi (opsiyonel) ---
  /// Fis yuklemek icin FuelingIntent ZORUNLU DEGIL ve olmayacak.
  fuelingIntentId         String?
  fuelingIntent           FuelingIntent? @relation(fields: [fuelingIntentId], references: [id], onDelete: SetNull)
  /// Bir yakit niyetine EN FAZLA BIR kesinlesmis fis baglanabilir.
  /// `submitted`/`approved` iken fuelingIntentId, aksi halde null — tekil
  /// indeksin tasiyicisi (Faz 5'teki activeDriverKey ile ayni desen).
  fuelingIntentSettledKey String?

  /// --- Ters kayit (Faz 9) ---
  /// Bu kayit tersine cevrildiyse iliskisi burada. VARLIGI kaydin muhasebe
  /// acisindan ETKISIZ oldugunu soyler; `workflowStatus` `approved` olarak
  /// KALIR cunku onayin gercekten yasandigi bir olay ve silinmemeli.
  reversal     FleetFuelEntryReversal? @relation("FuelEntryReversalOriginal")
  /// Bu kayit bir ters kaydin DUZELTILMIS KOPYASI ise iliskisi burada.
  correctionOf FleetFuelEntryReversal? @relation("FuelEntryReversalReplacement")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)

  fuelCardTransactions FuelCardTransaction[]

  /// --- Telematik mutabakati (Faz 11) ---
  /// Fis basina EN FAZLA BIR analiz. Analiz maliyeti DEGISTIRMEZ; yalnizca
  /// ayni fise bakan ayri bir okuma.
  reconciliation FuelReconciliation?

  @@unique([tenantId, receiptFileHash])
  @@unique([tenantId, fuelingIntentSettledKey])
  @@index([tenantId])
  @@index([vehicleId, enteredAt])
  @@index([driverId, enteredAt])
  @@index([tenantId, workflowStatus])
  /// Muhasebe kuyrugunun canonical sorgusu: kiraci + durum + en uzun bekleyen
  /// once. Buyuk filolarda her acilista tam tarama yapilmasin.
  @@index([tenantId, workflowStatus, submittedAt])
  @@index([tenantId, driverId, workflowStatus])
  @@index([fuelingIntentId])
  @@map("fleet_fuel_entries")
}

/// Onaylanmis bir yakit fisinin muhasebe tarafindan tersine cevrilmesi.
///
/// NEDEN AYRI BIR TABLO: orijinal kayit DEGISMIYOR. Onaylanmis bir tutari
/// yerinde duzeltmek ya da silmek, "muhasebe neyi onayladi" sorusunun
/// cevabini yok eder ve fis goruntusuyle kayit birbirini tutmaz hale gelir.
/// Append-only bir ters kayit ise hem gecmisi korur hem de raporlari
/// duzeltir.
///
/// NEDEN NEGATIF TUTAR YOK: reversal bir GIDER DEGIL, bir gecerlilik
/// ifadesidir. Negatif satir yazsaydik ters kaydin olusturuldugu ay sahte
/// bir negatif giderle kirlenirdi; oysa dogru davranis, orijinal tutarin
/// KENDI doneminden dusmesidir. Finansal dogruluk orijinal kaydin etkili
/// durumundan turetiliyor, kopyalanmiyor.
model FleetFuelEntryReversal {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Tersine cevrilen kayit. `@unique`: bir fis EN FAZLA BIR KEZ ters kayda
  /// alinabilir — bu kural uygulamada degil VERITABANINDA, cunku iki
  /// es zamanli istek uygulama kontrolunu birlikte gecebilir.
  originalEntryId String         @unique
  originalEntry   FleetFuelEntry @relation("FuelEntryReversalOriginal", fields: [originalEntryId], references: [id], onDelete: Restrict)

  /// Opsiyonel duzeltilmis kopya. `@unique`: bir duzeltme kaydi EN FAZLA BIR
  /// ters kayda ait olabilir.
  ///
  /// Zincir bu iki tekil alanla kuruluyor: bir replacement daha sonra yanlis
  /// onaylanirsa KENDISI de `originalEntryId` olarak yeni bir reversal'a
  /// girebilir. Orijinal -> Reversal -> Replacement -> Reversal -> ...
  replacementEntryId String?         @unique
  replacementEntry   FleetFuelEntry? @relation("FuelEntryReversalReplacement", fields: [replacementEntryId], references: [id], onDelete: Restrict)

  /// Sebep KODU: rapor ve filtre bunun uzerinden calisir, serbest metin uzerinden degil.
  reasonCode FuelEntryReversalReason
  /// Zorunlu insan aciklamasi. HTML olarak RENDER EDILMEZ.
  reason     String

  /// Islemi yapan muhasebeci. Kullanici silinirse ters kayit KALIR: denetim
  /// izi, aktoru artik cozulemese bile kaybolmamali.
  reversedById String?
  reversedBy   User?    @relation("FuelEntryReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  reversedAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, reversedAt])
  @@map("fleet_fuel_entry_reversals")
}

/// Ters kayit sebepleri. Serbest metin TEK BASINA yeterli degil: raporun
/// "kac fis yanlis tutarla onaylandi" sorusunu cevaplayabilmesi icin
/// sayilabilir bir kod gerekiyor.
enum FuelEntryReversalReason {
  duplicate
  incorrect_amount
  incorrect_vehicle
  incorrect_currency
  incorrect_date
  wrong_or_unreadable_document
  other
}

/// Mutabakat HESABININ teknik durumu. Risk seviyesiyle karistirilmamali:
/// hesap basarisiz olsa bile fis onayli kalir ve maliyete girer.
enum FuelReconciliationStatus {
  /// Fis onaylandi, hesap heniz calismadi. Onay isleminin AYNI transaction'i
  /// bu satiri yaziyor — telematik servisi ayakta olmasa bile is kaybolmaz.
  pending
  calculated
  /// Hesap tekrar tekrar basarisiz oldu. Kullaniciya teknik hata degil,
  /// "kontrol edilemedi" bilgisi gosterilir.
  failed
}

/// Mutabakat SONUCU.
///
/// SUCLAMA YOK: "hirsizlik" / "dolandiricilik" gibi bir deger BILINCLI OLARAK
/// bu listede yok. En agir sonuc bile yalnizca "insan baksin" der.
enum FuelReconciliationRiskLevel {
  /// Karar verecek veri yok (telematik yakit verisi yok, ornek yetersiz,
  /// kapasite bilinmiyor...). Sessiz gecmek DEGIL, acikca "veri yok" demek.
  insufficient_data
  normal
  review_required
  high_attention
}

/// Incelemenin acik/kapali durumu. Muhasebe kapattiktan sonra gec gelen
/// telematik verisi kaydi SESSIZCE YENIDEN ACMAZ.
enum FuelReconciliationReviewState {
  open
  closed
}

/// Muhasebenin karari — sayilabilir olmasi sart: "kac inceleme gercekten
/// duplicate cikti" sorusunun cevabi serbest metinden okunamaz.
enum FuelReconciliationReviewOutcome {
  valid
  corrected
  duplicate
  needs_investigation
}

/// ONAYLI bir yakit fisinin telematik/konum/arac verisiyle karsilastirilmasi.
///
/// NEDEN AYRI MODEL: `FleetFuelEntry` maliyetin canonical kaydi olarak
/// KALIYOR. Analiz onun bir OKUMASI; tutari, durumu ya da onayi degistirmez.
/// Analiz alanlarini fise gomseydik, algoritma her degistiginde maliyet
/// kaydinin `updatedAt`i degisir ve muhasebenin optimistic concurrency
/// kontrolu (updatedAt + updateMany) durup dururken cakisma uretirdi.
///
/// FIS BASINA TEK SATIR: `fuelEntryId` tekil. Yeniden hesaplama ayni satiri
/// gunceller, gecmis satir birikmez — "hangi sonuc gecerli" sorusunun tek
/// cevabi olsun.
model FuelReconciliation {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `@unique` TEK BASINA 1-1 iliskinin Prisma tarafindaki sarti; asagidaki
  /// `@@unique([tenantId, fuelEntryId])` ise kiraci sinirini VERITABANINDA
  /// tasiyor. Ikisi birlikte duruyor cunku ilki olmadan iliski kurulamiyor,
  /// ikincisi olmadan tekillik kiraci bagimsiz kaliyordu.
  fuelEntryId String         @unique
  fuelEntry   FleetFuelEntry @relation(fields: [fuelEntryId], references: [id], onDelete: Cascade)

  status    FuelReconciliationStatus    @default(pending)
  riskLevel FuelReconciliationRiskLevel @default(insufficient_data)
  /// Kurallarin agirlik toplami. TEK BASINA gosterilmez: kullaniciya kurallar
  /// ve aciklamalari gider, puan yalnizca siralama icindir.
  riskScore Int                         @default(0)

  /// Tetiklenen kurallar: [{ code, severity, weight, values }]. `code`
  /// cevirinin anahtari — sunucu KULLANICI DILINDE metin uretmiyor.
  signals     Json?
  /// Neyin eksik oldugu ve kac ornek kullanildigi. Arayuz "neden karar
  /// verilemedi"yi bundan yaziyor.
  dataQuality Json?
  /// Kurallarin kullandigi NORMALIZE degerler (litre, yuzde, mesafe, dakika).
  /// Ham telematik paketleri, GPS izi ve fis icerigi BURAYA KOPYALANMAZ.
  evidence    Json?

  /// Kural setinin surumu. Esikler degistiginde eski satirin hangi kurallarla
  /// uretildigi kaybolmasin.
  algorithmVersion Int       @default(1)
  calculatedAt     DateTime?
  /// Son yeniden hesaplama ani (gec gelen telematik verisi).
  recalculatedAt   DateTime?
  /// Teknik hata SINIFI, saglayici mesaji degil.
  failureClass     String?
  attemptCount     Int       @default(0)
  /// `high_attention` bildirimi bir kez gider. Yeniden hesaplama ayni sonucu
  /// verdiginde ikinci bildirim URETILMEZ.
  notifiedAt       DateTime?

  reviewState   FuelReconciliationReviewState    @default(open)
  reviewOutcome FuelReconciliationReviewOutcome?
  reviewedById  String?
  reviewedBy    User?                            @relation("FuelReconciliationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Zorunlu insan aciklamasi. HTML olarak RENDER EDILMEZ.
  reviewNote    String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, fuelEntryId])
  @@index([tenantId])
  /// Worker'in kuyrugu: bekleyen hesaplar.
  @@index([tenantId, status])
  /// Muhasebe listesi: risk + acik/kapali.
  @@index([tenantId, riskLevel, reviewState])
  @@map("fuel_reconciliations")
}

/// Otomasyona giren belgenin turu. Faz 13'te YALNIZCA servis faturasi.
/**
 * Blob'un HANGI ALT SISTEME ait oldugu — belge TURU degil.
 *
 * Kapali ve kucuk bir kume oldugu icin enum kalabiliyor. Belge turleri
 * (`service_invoice@v1`, `traffic_fine@v1`, ...) buyuyen bir kume oldugu icin
 * BURAYA GIRMEZ; onlar registry ile dogrulanan surumlu anahtarlardir.
 */
enum AutomationDocumentKind {
  /// Faz 13 — dogrudan servis faturasi yuklemesi.
  service_invoice
  /// Faz 14 — belge gelen kutusu yuklemesi. Turu mantiksal belge belirler.
  document_intake
}

/**
 * Otomasyona verilen belge (Faz 13).
 * NEDEN DAR BIR MODEL: repodaki `Document` kaydi surucu/arac evraki icin
 * tasarlanmis (kategori, son kullanma, sahiplik) ve otomasyonun ihtiyaci
 * bunlarin hicbiri degil. Var olani zorlamak, iki farkli isi tek tabloda
 * bulandirirdi. Bu model bilincli olarak DAR: Faz 14'te belge turleri
 * genisledikce buyuyecek.
 * DOSYA YOLU DISARI CIKMAZ: `storedFileName` yalnizca sunucu tarafinda
 * kullaniliyor; API yaniti ve loglar bu alani ICERMEZ.
 */
model AutomationDocument {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  kind AutomationDocumentKind @default(service_invoice)

  /// SHA-256. Ayni kiraci icinde birebir ayni dosya iki kez yuklenemez —
  /// ikinci yukleme yeni is acmaz, var olan belgeyi doner.
  fileHash String

  /// Diskteki ad. API'ye ASLA cikmaz.
  storedFileName String
  mimeType       String
  originalName   String
  fileSize       Int

  /// Web/mobil yuklemede kullanici. Connector (tarayici) yuklemesinde YOK:
  /// bir makinenin arkasinda o an bir insan olmayabilir ve olmayan kullaniciyi
  /// uydurmak, denetimde sahte bir sorumlu yaratirdi.
  uploadedById String?
  uploadedBy   User?    @relation("AutomationDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  jobs    AutomationJob[]
  intakes DocumentIntake[]

  /// Kiraci ICINDE tekil: baska bir kiracinin ayni dosyayi yuklemesi
  /// engellenmez ve varligi da sizdirilmaz.
  @@unique([tenantId, fileHash])
  @@index([tenantId])
  @@index([tenantId, kind, createdAt])
  @@map("automation_documents")
}

model FuelCardImportBatch {
  id               String   @id @default(cuid())
  tenantId         String   @default("default-tenant")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceFileName   String
  sourceStoredPath String?
  sourceMimeType   String?
  importedAt       DateTime @default(now())
  totalRows        Int      @default(0)
  matchedRows      Int      @default(0)
  unmatchedRows    Int      @default(0)
  ignoredRows      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions FuelCardTransaction[]

  @@index([tenantId])
  @@map("fuel_card_import_batches")
}

model FuelCardTransaction {
  id                String                    @id @default(cuid())
  tenantId          String                    @default("default-tenant")
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batchId           String
  vehicleId         String?
  driverId          String?
  fuelEntryId       String?
  externalReference String?
  cardLast4         String?
  merchantName      String
