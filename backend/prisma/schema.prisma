  consecutiveFailureCount Int                         @default(0)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@index([tenantId])
  @@index([subject, nextDueAt])
  @@index([enabled, nextDueAt])
  @@index([driverId])
  @@index([vehicleId])
  @@index([lastFulfilledDddFileId])
  @@map("tacho_download_schedules")
}
