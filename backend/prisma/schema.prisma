/// Bir istasyonda satilan ya da bir aracin kabul ettigi tek bir urun.
///
/// Degerler BUYUK HARF: bunlar bizim ic durum adlarimiz degil, pompadaki urun
/// kodlari (CalendarStatus'un AT/UT/KT'si gibi). SUPER_E5 ile SUPER_E10 AYRI
/// iki deger — birini kabul eden aracin digerini de kabul ettigi VARSAYILAMAZ,
/// E10 eski benzinli motorlarda hasara yol acar. Ayni sekilde HVO100 dizel
/// motorda "dizelin bir turu" degil, ayri bir onay isidir.
enum FuelProductType {
  DIESEL
  SUPER_E5
  SUPER_E10
  SUPER_PLUS
  HVO100
  CNG
  LNG
  ELECTRICITY
  HYDROGEN
  /// Katki maddesi (SCR sivisi). ASLA ana yakit degil — bkz. FuelProductUsage.
  ADBLUE
}

/// Aracin bir urunle iliskisi.
///
/// ADDITIVE ayrimi kritik: AdBlue arac icin gerekli olabilir ama istasyon
/// ONERISINI belirlemez. AdBlue'yu PRIMARY saymak, sadece AdBlue satan bir
/// noktayi "yakit istasyonu" diye surucuye gostermek olurdu.
enum FuelProductUsage {
  PRIMARY
  ALTERNATIVE
  ADDITIVE
}

/// Uyumluluk bilgisinin nereden geldigi. Denetim izi icin tutuluyor: bir
/// aracin HVO100 onayi ureticiden mi geldi yoksa ofis elle mi isaretledi,
/// yanlis yakit hasarinda sorulacak ilk sorudur.
enum FuelCompatibilitySource {
  MANUFACTURER
  VIN
  ADMIN
  IMPORTED
}

/// Aracin ACIKCA onaylanmis yakit urunleri.
///
/// Neden Vehicle uzerinde tek bir alan degil: bir arac birden fazla urun kabul
/// edebilir (E5 + E10) ve her kaydin kendi kaynagi/dogrulama zamani olmali.
/// Tek enum alani bunu tasiyamaz.
///
/// CIKARIM YOK: burada satiri olmayan urun o arac icin onaysizdir. Sistem
/// "dizel varsa HVO100 da olur" ya da "E10 varsa E5 de olur" gibi bir tahmin
/// YURUTMEZ; uyumluluk hic tanimli degilse cagiran uc 409 ile durur.
model VehicleFuelCompatibility {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  vehicleId String
  /// Arac kaydiyla birlikte gider: bu tablo aracin teknik ozelligidir, bagimsiz
  /// bir is kaydi degil. (Silme ucu yok, arac deactivate ediliyor — bkz.
  /// VehiclesService.deactivate; Cascade yalnizca gercek bir silmede devreye girer.)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  productType FuelProductType
  usageType   FuelProductUsage
  /// false, "bu urun acikca ONAYLANMADI" demektir — kaydin yoklugundan farkli
  /// bir bilgi (ureticinin acik reddi). Filtreleme her iki durumda da urunu
  /// disarida birakir.
  approved    Boolean                 @default(true)
  source      FuelCompatibilitySource
  /// Bilginin son dogrulandigi an. null ise kayit var ama teyit edilmemis.
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ayni arac/urun/kullanim ucusu iki kez yazilamaz — PUT tum seti
  /// degistirirken cift kayit uretmesin.
  @@unique([tenantId, vehicleId, productType, usageType])
  @@index([tenantId])
  @@index([vehicleId])
  @@map("vehicle_fuel_compatibility")
}

/// Yakit niyetinin yasam dongusu.
///
/// Bir surucunun AYNI ANDA en fazla bir ACTIVE kaydi olabilir; geri kalan dort
/// deger terminaldir (kayit bir daha aktif olmaz).
enum FuelingIntentStatus {
  ACTIVE
  /// Surucu vazgecti.
  CANCELLED
  /// Surucu baska bir istasyon secti; bu kayit yerini yenisine birakti.
  SUPERSEDED
  /// Yakit alindi. Bu fazda HICBIR YERDEN yazilmiyor — fis/OCR akisinin
  /// (Prompt 6) girisi olarak ayrilmis durumda. Sahte tamamlama uretilmiyor.
  COMPLETED
  /// Calisma gununun (ya da bagimsiz secimde 24 saatin) sonuna gelindi.
  EXPIRED
}

/// Surucunun secitigi GECICI yakit duragi.
///
/// NEDEN TourStop DEGIL: yakit duragi bir musteri teslimat/toplama noktasi
/// degildir. TourStop olarak yazilsaydi (a) `sequence` uzerinden musteri
/// duraklarinin sirasina girerdi, (b) tur optimizasyonunun girdisi olurdu,
/// (c) `tourId` zorunlu oldugu icin turdan bagimsiz yakit alimi hic
/// modellenemezdi. Ucu de istenmeyen sonuclar. Bu yuzden AYRI bir kayit:
/// canonical tur plani (Tour, TourStop, optimizedRoute) bu tablodan HIC
/// etkilenmez.
///
/// `anchorTourStopId` yalnizca BAGLAM: "istasyon bu duraga giderken
/// onerilmisti". TourStop.sequence'e dokunmaz, siralamaya girmez.
///
/// Istasyon anlik gorunumu (snapshot) tarihseldir: secim anindaki fiyat ve
/// rota sapmasi burada donar, sonradan otomatik guncellenmez. `quotedPricePerLitre`
/// ARAMA ANINDAKI saglayici fiyatidir — odenen fiyat DEGILDIR; gercek tutar
/// fis akisindan gelecek.
model FuelingIntent {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Her ikisi de SUNUCUDA oturumdaki surucuden cozulur; istemci gonderemez.
  driverId  String
  driver    Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Turdan BAGIMSIZ secim gecerlidir: aktif tur yoksa, rota hesaplanamadiysa
  /// ya da surucu yalnizca yakin istasyon aradiysa bu alanlar null kalir.
  tourId           String?
  tour             Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)
  anchorTourStopId String?
  anchorTourStop   TourStop? @relation(fields: [anchorTourStopId], references: [id], onDelete: SetNull)

  status FuelingIntentStatus @default(ACTIVE)

  /// "Bir surucunun en fazla bir aktif niyeti" kuralinin VERITABANI karsiligi.
  ///
  /// ACTIVE iken driverId, terminal duruma gecince null. Postgres tekil
  /// indekste NULL'lari birbirinden farkli saydigi icin istedigimiz kadar
  /// terminal kayit birikebilir ama ikinci bir ACTIVE satir yazilamaz.
  /// Uygulama katmanindaki findFirst kontrolu tek basina yeterli olmazdi:
  /// iki es zamanli istek ikisi de "aktif yok" gorup iki kayit yaratirdi.
  activeDriverKey String?

  /// --- Istasyon snapshot'i: YALNIZCA secilen istasyon ---
  /// Arama sonucundaki diger istasyonlar DB'ye YAZILMAZ; kalici bir
  /// Tankerkonig istasyon katalogu olusturulmuyor.
  provider            String
  providerStationId   String
  stationName         String
  stationBrand        String?
  /// Adres parcali ve her parcasi ayri nullable: saglayici eksik verdiginde
  /// kalan parca uydurulmuyor (bkz. FuelStationAddress).
  stationStreet       String?
  stationHouseNumber  String?
  stationPostalCode   String?
  stationCity         String?
  stationLatitude     Decimal         @db.Decimal(10, 7)
  stationLongitude    Decimal         @db.Decimal(10, 7)
  selectedFuelProduct FuelProductType
  /// ARAMA ANINDAKI saglayici fiyati. Odenen fiyat degildir ve arayuz bunu
  /// acikca "arama anindaki fiyat" olarak etiketler. Para alani -> Decimal.
  quotedPricePerLitre Decimal?        @db.Decimal(10, 4)
  priceRetrievedAt    DateTime?
  /// Kaynak atfi secim aninda dondurulur (CC BY 4.0 zorunlulugu).
  attributionLabel    String
  attributionUrl      String?

  /// --- Secim ve rota snapshot'i ---
  /// Surucunun hassas BASLANGIC KONUMU bilincli olarak YOK: kalici bir takip
  /// verisi uretmiyoruz. Asagidaki metrikler o konumdan turetilmis ozetlerdir.
  plannedLitres         Decimal?  @db.Decimal(8, 2)
  /// Secim anindaki rota baglami: 'active_tour' | 'nearby_only'
  /// (kaynak: RouteContext.mode — ikinci bir dogruluk kaynagi uretmemek icin
  /// enum degil string).
  routeMode             String?
  extraDistanceKm       Decimal?  @db.Decimal(12, 3)
  extraDurationMin      Decimal?  @db.Decimal(8, 1)
  driveTimeToStationMin Decimal?  @db.Decimal(8, 1)
  /// Tahmini SURUS varisi. Varis garantisi DEGIL; yakit alma suresi dahil degil.
  stationEta            DateTime?
  routeCalculatedAt     DateTime?

  selectedAt         DateTime  @default(now())
  /// Harici navigasyonun ACILDIGI an. Varis ya da yakit alma kaniti DEGIL.
  navigationOpenedAt DateTime?
  cancelledAt        DateTime?
  supersededAt       DateTime?
  completedAt        DateTime?
  /// Aktif niyet sonsuza kadar yasamaz. Tura bagliysa turun calisma gununun
  /// sonu (Europe/Berlin), bagimsizsa secimden 24 saat sonra.
  expiresAt          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bu niyete baglanan yakit fisleri. Fis yuklemek icin niyet ZORUNLU DEGIL;
  /// bag opsiyonel ve tek yonlu bir baglamdir.
  fuelEntries FleetFuelEntry[]

