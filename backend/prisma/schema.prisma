/// Telematikten gelen YAKIT SEVIYESI zaman serisi.
///
/// NEDEN AYRI BIR TABLO: `VehicleTelemetryLatest` her cerceve ile UZERINE
/// YAZILIYOR — yani "fis saatinde depo ne kadardi" sorusunun veritabaninda
/// bir cevabi yoktu. Yakit fisi mutabakati tam olarak bu soruyu soruyor.
///
/// SEYRELTILEREK yaziliyor (bkz. FUEL_LEVEL_SAMPLE_MIN_INTERVAL_MS /
/// _MIN_DELTA_PCT): her cerceveyi saklamak, cihaz basina saniyede bir satir
/// demekti ve tasima degeri olmayan bir gurultuyu kalici hale getirirdi.
/// Seviye ATLADIGINDA (yakit alimi) kayit her halukarda dusuyor.
///
/// GECMISE DONUK VERI YOK: bu tablo ancak devreye alindiktan SONRAKI fisler
/// icin doludur. Eski fislerin analizi bu yuzden `insufficient_data` kalir ve
/// uydurma bir karsilastirma URETILMEZ.
model VehicleFuelLevelSample {
  id           String   @id @default(cuid())
  tenantId     String   @default("default-tenant")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// CIHAZ zamani (paketin kendi damgasi), sunucunun aldigi an degil.
  recordedAt   DateTime
  fuelLevelPct Decimal  @db.Decimal(5, 2)
  /// Kontak durumu: yakit alimi cogunlukla kontak KAPALIYKEN olur ve bazi
  /// araclarda seviye yalnizca kontak aciklandiginda guncellenir.
  ignition     Boolean  @default(false)
  odometerKm   Decimal? @db.Decimal(12, 3)
  createdAt    DateTime @default(now())

  /// Ayni cihaz zamani iki kez gelirse (tekrar gonderim) ikinci satir
  /// yazilmaz — cihaz tekrarlari sahte bir "seviye degisimi" uretmesin.
  @@unique([vehicleId, recordedAt])
  @@index([tenantId])
  /// Saklama suresi temizligi bu indeksten yururuyor.
  @@index([recordedAt])
  @@map("vehicle_fuel_level_samples")
}

