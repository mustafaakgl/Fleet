}

/// Koordinatin 40t kamyonla ulasilabilir bir yola snap edilip edilemedigi.
/// Tek bir ulasilamaz durak tum tur optimizasyonunu cokerttigi icin adres
/// kaydedilirken dogrulanir, optimizasyon aninda degil.
enum TruckAccessStatus {
  unknown
  reachable
  unreachable
  check_failed
}

