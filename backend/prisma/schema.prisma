  vehicle     Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignment  Assignment?                @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  template    ChecklistTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  itemResults DepartureCheckItemResult[]
  defects     Defect[]

  @@unique([driverId, vehicleId, workDate])
  @@index([tenantId])
  @@index([driverId, workDate])
  @@index([vehicleId, workDate])
  @@index([assignmentId])
  @@index([performedAt])
}

model DepartureCheckItemResult {
  id                String                   @id @default(cuid())
  departureCheckId  String
  templateItemId    String?
  itemKey           String
  itemLabel         String
  sortOrder         Int
  result            DepartureCheckItemStatus
  defectDescription String?
  photoStoredPaths  String[]
  photoMetadata     Json?
  createdAt         DateTime                 @default(now())

  departureCheck DepartureCheck         @relation(fields: [departureCheckId], references: [id], onDelete: Cascade)
  templateItem   ChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  defects        Defect[]

  @@index([departureCheckId, sortOrder])
  @@index([templateItemId])
}

/// Vehicle defect (Mängel) with status chain and audit trail.
model Defect {
  id                         String         @id @default(cuid())
  tenantId                   String         @default("default-tenant")
  tenant                     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId                  String
  reportedByDriverId         String
  source                     DefectSource
  departureCheckId           String?
  departureCheckItemResultId String?
  title                      String?
  description                String
  severity                   DefectSeverity
  status                     DefectStatus   @default(offen)
  photoStoredPaths           String[]
  photoMetadata              Json?
  repairCompany              String?
  estimatedRepairDate        DateTime?      @db.Date
  serviceRecordId            String?
  confirmationDriverId       String?
  confirmedAt                DateTime?
  anonymizedAt               DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  vehicle                  Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  reportedBy               Driver                    @relation("DefectReportedBy", fields: [reportedByDriverId], references: [id], onDelete: Restrict)
  departureCheck           DepartureCheck?           @relation(fields: [departureCheckId], references: [id], onDelete: SetNull)
  departureCheckItemResult DepartureCheckItemResult? @relation(fields: [departureCheckItemResultId], references: [id], onDelete: SetNull)
  serviceRecord            ServiceRecord?            @relation(fields: [serviceRecordId], references: [id], onDelete: SetNull)
  confirmationDriver       Driver?                   @relation("DefectConfirmationDriver", fields: [confirmationDriverId], references: [id], onDelete: SetNull)
  statusLogs               DefectStatusLog[]

  @@index([tenantId])
  @@index([vehicleId, status])
  @@index([vehicleId, severity, status])
  @@index([reportedByDriverId, createdAt])
  @@index([confirmationDriverId, status])
  @@index([departureCheckId])
  @@index([anonymizedAt])
}

/// Immutable audit log for every defect status transition.
model DefectStatusLog {
  id                  String        @id @default(cuid())
  tenantId            String        @default("default-tenant")
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  defectId            String
  fromStatus          DefectStatus?
  toStatus            DefectStatus
  changedByUserId     String?
  changedByDriverId   String?
  note                String?
  repairCompany       String?
  estimatedRepairDate DateTime?     @db.Date
  createdAt           DateTime      @default(now())

  defect          Defect  @relation(fields: [defectId], references: [id], onDelete: Cascade)
  changedByUser   User?   @relation("DefectStatusChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByDriver Driver? @relation("DefectStatusChangedByDriver", fields: [changedByDriverId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([defectId, createdAt])
}

/// Daily reminder / escalation state when morning departure check is missing.
model DepartureCheckReminderState {
  id                   String    @id @default(cuid())
  tenantId             String    @default("default-tenant")
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId             String
  workDate             DateTime  @db.Date
  lastReminderSentAt   DateTime?
  lastEscalationSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, workDate])
  @@index([tenantId])
  @@index([workDate])
}

/// Traffic fine (Bußgeld) with driver matching and status workflow.
model Fine {
  id                         String                @id @default(cuid())
  tenantId                   String                @default("default-tenant")
  tenant                     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId                  String
  driverId                   String?
  matchType                  FineMatchType         @default(unmatched)
  matchedWorkSessionId       String?
  matchedAssignmentId        String?
  violationAt                DateTime
  violationLocation          String
  violationType              String
  violationCategory          FineViolationCategory
  amount                     Decimal?              @db.Decimal(10, 2)
  paymentDueDate             DateTime?             @db.Date
  noticeDate                 DateTime?             @db.Date
  documentStoredPath         String?
  documentMimeType           String?
  status                     FineStatus            @default(neu)
  notes                      String?
  matchCandidates            Json?
  matchToleranceMinutes      Int                   @default(30)
  driverNotifiedAt           DateTime?
  driverAcknowledgedAt       DateTime?
  driverAckMetadata          Json?
  lastDriverReminderSentAt   DateTime?
  lastDriverEscalationSentAt DateTime?
  lastPaymentReminderDays    Int?
  lastPaymentReminderSentAt  DateTime?
  createdByUserId            String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  vehicle            Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver             Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  matchedWorkSession WorkSession?    @relation(fields: [matchedWorkSessionId], references: [id], onDelete: SetNull)
  matchedAssignment  Assignment?     @relation(fields: [matchedAssignmentId], references: [id], onDelete: SetNull)
  createdBy          User?           @relation("FineCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  statusLogs         FineStatusLog[]

  @@index([tenantId])
  @@index([vehicleId, violationAt])
  @@index([driverId, violationAt])
  @@index([status])
  @@index([paymentDueDate])
  @@index([noticeDate])
  @@index([matchType])
  @@index([violationCategory])
}

/// Immutable audit log for every fine status transition.
model FineStatusLog {
  id                String      @id @default(cuid())
  tenantId          String      @default("default-tenant")
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fineId            String
  fromStatus        FineStatus?
  toStatus          FineStatus
  changedByUserId   String?
  changedByDriverId String?
  note              String?
  createdAt         DateTime    @default(now())

  fine            Fine    @relation(fields: [fineId], references: [id], onDelete: Cascade)
  changedByUser   User?   @relation("FineStatusChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByDriver Driver? @relation("FineStatusChangedByDriver", fields: [changedByDriverId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([fineId, createdAt])
}

// --- Fleet analytics (phone GPS Phase 1; Faz 2 device/API adapters write same tables) ---

model FleetTrip {
  id              String               @id @default(cuid())
  tenantId        String               @default("default-tenant")
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId       String
  driverId        String
  source          FleetTelemetrySource @default(phone)
  purpose         TripPurpose?
  purposeNote     String?
  businessContact String?
  classifiedAt    DateTime?
  classifiedById  String?
  purposeLockedAt DateTime?
  odoStartKm      Decimal?             @db.Decimal(12, 3)
  odoEndKm        Decimal?             @db.Decimal(12, 3)
  startedAt       DateTime
  endedAt         DateTime?
  distanceKm      Decimal?             @db.Decimal(12, 3)
  durationS       Int?
  avgSpeedKmh     Decimal?             @db.Decimal(8, 2)
  maxSpeedKmh     Decimal?             @db.Decimal(8, 2)
  idleS           Int?
  score           Decimal?             @db.Decimal(5, 2)
  hasDataGap      Boolean              @default(false)
  status          FleetTripStatus      @default(active)
  assignmentId    String?
  workSessionId   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  vehicle        Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver         Driver                   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  assignment     Assignment?              @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  workSession    WorkSession?             @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  classifiedBy   User?                    @relation("FleetTripClassifiedBy", fields: [classifiedById], references: [id], onDelete: SetNull)
  locationPoints FleetTripLocationPoint[]
  drivingEvents  FleetDrivingEvent[]
  purposeLogs    FleetTripPurposeLog[]

  @@index([tenantId])
  @@index([vehicleId, startedAt])
  @@index([driverId, startedAt])
  @@index([status, startedAt])
  @@index([assignmentId])
  @@index([workSessionId])
  @@map("fleet_trips")
}

model FleetTripPurposeLog {
  id          String       @id @default(cuid())
  tenantId    String       @default("default-tenant")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tripId      String
  trip        FleetTrip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  oldPurpose  TripPurpose?
  newPurpose  TripPurpose
  oldNote     String?
  newNote     String?
  changedById String
  changedBy   User         @relation("FleetTripPurposeChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime     @default(now())
  reason      String?

  @@index([tenantId])
  @@index([tripId, changedAt])
  @@index([changedById, changedAt])
  @@map("fleet_trip_purpose_logs")
}

model FleetTripLocationPoint {
  id         String               @id @default(cuid())
  tripId     String
  recordedAt DateTime
  latitude   Decimal              @db.Decimal(10, 7)
  longitude  Decimal              @db.Decimal(10, 7)
  speedKmh   Float?
  headingDeg Float?
  accuracyM  Float?
  source     FleetTelemetrySource @default(phone)
  receivedAt DateTime             @default(now())

  trip FleetTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, recordedAt, latitude, longitude])
  @@index([tripId, recordedAt])
  @@map("fleet_trip_location_points")
}

model FleetDrivingEvent {
  id         String                @id @default(cuid())
  tenantId   String                @default("default-tenant")
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tripId     String
  driverId   String
  type       FleetDrivingEventType
  occurredAt DateTime
  latitude   Decimal               @db.Decimal(10, 7)
  longitude  Decimal               @db.Decimal(10, 7)
  value      Decimal               @db.Decimal(10, 3)
  threshold  Decimal               @db.Decimal(10, 3)
  createdAt  DateTime              @default(now())

  trip   FleetTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver    @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tripId, occurredAt])
  @@index([driverId, occurredAt])
  @@index([type, occurredAt])
  @@map("fleet_driving_events")
}

model FleetFuelEntry {
  id                String   @id @default(cuid())
  tenantId          String   @default("default-tenant")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId         String
  driverId          String
  enteredAt         DateTime
  liters            Decimal  @db.Decimal(10, 3)
  totalCost         Decimal  @db.Decimal(12, 2)
  currency          String   @default("EUR")
  odometerKm        Decimal? @db.Decimal(12, 3)
  isFullTank        Boolean  @default(false)
  receiptStoredPath String?
  receiptMimeType   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)

  fuelCardTransactions FuelCardTransaction[]

  @@index([tenantId])
  @@index([vehicleId, enteredAt])
  @@index([driverId, enteredAt])
  @@map("fleet_fuel_entries")
}

model FuelCardImportBatch {
  id               String   @id @default(cuid())
  tenantId         String   @default("default-tenant")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceFileName   String
  sourceStoredPath String?
  sourceMimeType   String?
  importedAt       DateTime @default(now())
  totalRows        Int      @default(0)
  matchedRows      Int      @default(0)
  unmatchedRows    Int      @default(0)
  ignoredRows      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions FuelCardTransaction[]

  @@index([tenantId])
  @@map("fuel_card_import_batches")
}

model FuelCardTransaction {
  id                String                    @id @default(cuid())
  tenantId          String                    @default("default-tenant")
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batchId           String
  vehicleId         String?
  driverId          String?
  fuelEntryId       String?
  externalReference String?
  cardLast4         String?
  merchantName      String
  transactionAt     DateTime
  liters            Decimal?                  @db.Decimal(10, 3)
  amount            Decimal                   @db.Decimal(12, 2)
  currency          String                    @default("EUR")
  odometerKm        Decimal?                  @db.Decimal(12, 3)
  status            FuelCardTransactionStatus @default(imported)
  matchScore        Int?
  matchNote         String?
  rawPayload        Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  batch     FuelCardImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver    Driver?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  fuelEntry FleetFuelEntry?     @relation(fields: [fuelEntryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([batchId])
  @@index([vehicleId, transactionAt])
  @@index([driverId, transactionAt])
  @@index([fuelEntryId])
  @@index([status])
  @@map("fuel_card_transactions")
}

model FleetMaintenanceRule {
  id             String    @id @default(cuid())
  tenantId       String    @default("default-tenant")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId      String
  name           String
  intervalKm     Decimal?  @db.Decimal(12, 3)
  intervalDays   Int?
  lastDoneAtKm   Decimal?  @db.Decimal(12, 3)
  lastDoneAtDate DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId])
  @@map("fleet_maintenance_rules")
}

model DddFile {
  id                     String                  @id @default(cuid())
  tenantId               String                  @default("default-tenant")
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId              String?
  vehicle                Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId               String?
  driver                 Driver?                 @relation(fields: [driverId], references: [id], onDelete: SetNull)
  uploadedByUserId       String?
  fileType               DddFileType
  source                 DddFileSource           @default(manual)
  capturedAt             DateTime
  storedPath             String
  sizeBytes              Int
  sha256                 String
  generation             Int?
  signatureValid         Boolean?
  skippedBlocks          Json?
  status                 DddFileProcessingStatus @default(pending)
  processingErrorSummary String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  activities                 TachoActivity[]
  infringements              TachoInfringement[]
  fulfilledDownloadSchedules TachoDownloadSchedule[] @relation("TachoScheduleFulfilledByFile")

  @@unique([tenantId, sha256])
  @@index([tenantId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([tenantId, status])
  @@map("ddd_files")
}

model TachoProviderCredential {
  id               String        @id @default(cuid())
  tenantId         String        @default("default-tenant")
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider         TachoProvider
  encryptedPayload String
  lastUsedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("tacho_provider_credentials")
}

model TachoActivity {
  id           String         @id @default(cuid())
  tenantId     String         @default("default-tenant")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dddFileId    String?
  dddFile      DddFile?       @relation(fields: [dddFileId], references: [id], onDelete: SetNull)
  vehicleId    String
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId     String?
  driver       Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverCardNo String?
  workState    TachoWorkState
  startedAt    DateTime
  endedAt      DateTime
  durationS    Int
  createdAt    DateTime       @default(now())

  @@index([tenantId])
  @@index([dddFileId])
  @@index([vehicleId, startedAt])
  @@index([driverId, startedAt])
  @@map("tacho_activities")
}

model TachoInfringement {
  id                  String                @id @default(cuid())
  tenantId            String                @default("default-tenant")
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId            String
  driver              Driver                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId           String?
  vehicle             Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  dddFileId           String?
  dddFile             DddFile?              @relation(fields: [dddFileId], references: [id], onDelete: SetNull)
  type                TachoInfringementType
  severity            DtcSeverity
  occurredAt          DateTime
  notes               String?
  acknowledgedAt      DateTime?
  acknowledgedById    String?
  acknowledgedBy      User?                 @relation("TachoInfringementAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  payrollRelevant     Boolean               @default(false)
  payrollMarkedAt     DateTime?
  payrollMarkedById   String?
  payrollMarkedBy     User?                 @relation("TachoInfringementPayrollMarkedBy", fields: [payrollMarkedById], references: [id], onDelete: SetNull)
  acknowledgementNote String?
  createdAt           DateTime              @default(now())

  @@unique([tenantId, driverId, type, occurredAt])
  @@index([tenantId])
  @@index([tenantId, acknowledgedAt])
  @@index([tenantId, acknowledgedAt, occurredAt])
  @@index([driverId, occurredAt])
  @@index([dddFileId])
  @@map("tacho_infringements")
}

model TachoDownloadSchedule {
  id                      String                      @id @default(cuid())
  tenantId                String                      @default("default-tenant")
  tenant                  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subject                 TachoDownloadSubject
  driverId                String?
  driver                  Driver?                     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId               String?
  vehicle                 Vehicle?                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  intervalDays            Int                         @default(28)
  nextDueAt               DateTime
  lastDownloadAt          DateTime?
  lastFulfilledAt         DateTime?
  lastFulfilledDddFileId  String?
  lastFulfilledDddFile    DddFile?                    @relation("TachoScheduleFulfilledByFile", fields: [lastFulfilledDddFileId], references: [id], onDelete: SetNull)
  lastReminderStage       TachoDownloadReminderStage?
  lastReminderSentAt      DateTime?
  enabled                 Boolean                     @default(true)
  lastAttemptAt           DateTime?
  lastError               String?
  consecutiveFailureCount Int                         @default(0)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@index([tenantId])
  @@index([subject, nextDueAt])
  @@index([enabled, nextDueAt])
  @@index([driverId])
  @@index([vehicleId])
  @@index([lastFulfilledDddFileId])
  @@map("tacho_download_schedules")
}
