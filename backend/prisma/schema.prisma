enum LocationTrackingStatus {
  active
  paused
  denied
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  status       TenantStatus @default(provisioning)
  contactEmail String?
  contactPhone String?
  address      String?
  language     String       @default("de")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users                      User[]
  invitations                UserInvitation[]
  subscription               TenantSubscription?
  drivers                    Driver[]
  vehicles                   Vehicle[]
  companies                  Company[]
  assignments                Assignment[]
  transportRequests          TransportRequest[]
  calendarEvents             CalendarEvent[]
  requests                   Request[]
  documents                  Document[]
  vehicleHandovers           VehicleHandover[]
  accidents                  Accident[]
  companyEmails              CompanyEmail[]
  notifications              Notification[]
  reminders                  Reminder[]
  morningCheckins            MorningCheckin[]
  serviceRecords             ServiceRecord[]
  conversations              Conversation[]
  messageAttachments         MessageAttachment[]
  messageTranslations        MessageTranslation[]
  auditLogs                  AuditLog[]
  driverLocationHistory      DriverLocationHistory[]
  driverLocationLatest       DriverLocationLatest[]
  customerAssignmentMessages CustomerAssignmentMessage[]
  workSessions               WorkSession[]
  vehicleEquipment           VehicleEquipment[]
  driverLicenses             DriverLicense[]
  licenseChecks              LicenseCheck[]
  checklistTemplates         ChecklistTemplate[]
  departureChecks            DepartureCheck[]
  defects                    Defect[]
  defectStatusLogs           DefectStatusLog[]
  departureCheckReminders    DepartureCheckReminderState[]
  fines                      Fine[]
  fineStatusLogs             FineStatusLog[]
  fleetTrips                 FleetTrip[]
  fleetTripPurposeLogs       FleetTripPurposeLog[]
  fleetDrivingEvents         FleetDrivingEvent[]
  fleetFuelEntries           FleetFuelEntry[]
  fuelCardImportBatches      FuelCardImportBatch[]
  fuelCardTransactions       FuelCardTransaction[]
  fleetMaintenanceRules      FleetMaintenanceRule[]
  devices                    Device[]
  vehicleTelemetryLatest     VehicleTelemetryLatest[]
  vehicleDtcs                VehicleDtc[]
  tachoProviderCredentials   TachoProviderCredential[]
  dddFiles                   DddFile[]
  tachoActivities            TachoActivity[]
  tachoInfringements         TachoInfringement[]
  tachoDownloadSchedules     TachoDownloadSchedule[]
  telemetryQuarantine        TelemetryQuarantine[]
  equipmentIssuances         EquipmentIssuance[]
  billingProfile             TenantBillingProfile?
  rateCards                  RateCard[]
  rateCardItems              RateCardItem[]
  outgoingInvoices           Invoice[]
  invoiceLines               InvoiceLine[]
  invoiceAssignmentClaims    InvoiceAssignmentClaim[]
  invoiceNumberSequences     InvoiceNumberSequence[]
  invoicePayments            InvoicePayment[]
  invoiceDeliveryAttempts    InvoiceDeliveryAttempt[]
  invoiceAuditEvents         InvoiceAuditEvent[]
  dunningNotices             DunningNotice[]
  datevExports               DatevExport[]
  locations                  Location[]
  tours                      Tour[]
  tourStops                  TourStop[]
  workTimeEvents             WorkTimeEvent[]
}

model TenantBillingProfile {
  id                          String   @id @default(cuid())
  tenantId                    String   @unique
  tenant                      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  legalName                   String
  street                      String
  postalCode                  String
  city                        String
  countryCode                 String   @default("DE")
  taxNumber                   String?
  vatId                       String?
  /**
   * BT-30 seller legal registration id (Handelsregisternummer). EN 16931 BR-CO-26 needs
   * this whenever the seller has no VAT id, which is the normal § 19 UStG case.
   */
  registrationNumber          String?
  /**
   * BT-42 seller contact telephone. XRechnung BR-DE-6 makes it mandatory.
   */
  phone                       String?
  iban                        String
  bic                         String?
  bankName                    String?
  invoiceNumberFormat         String   @default("RE-{YYYY}-{00001}")
  defaultPaymentTermDays      Int      @default(14)
  defaultTaxRateBasisPoints   Int      @default(1900)
  smallBusinessRule           Boolean  @default(false)
  logoStoredPath              String?
  invoiceFooterText           String?
  invoiceEmailCc              String?
  dunningEnabled              Boolean  @default(true)
  dunningLevel1Days           Int      @default(1)
  dunningLevel2Days           Int      @default(14)
  dunningLevel3Days           Int      @default(28)
  dunningLevel1FeeCents       Int      @default(0)
  dunningLevel2FeeCents       Int      @default(500)
  dunningLevel3FeeCents       Int      @default(1000)
  datevConsultantNumber       String?
  datevClientNumber           String?
  datevChart                  String   @default("SKR03")
  revenueAccount19            String   @default("8400")
  revenueAccount7             String   @default("8300")
  revenueAccount0             String   @default("8125")
  revenueAccountReverseCharge String   @default("8337")
  debtorNumberStart           Int      @default(10000)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([tenantId])
}

model TenantSubscription {
  id                     String        @id @default(cuid())
  tenantId               String        @unique
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   BillingPlan   @default(basic)
  status                 BillingStatus @default(trialing)
  billingMode            BillingMode   @default(stripe)
  stripeCustomerId       String?       @unique
  stripeSubscriptionId   String?       @unique
  stripePriceId          String?
  vehicleLimit           Int           @default(15)
  seatLimit              Int           @default(5)
  monthlyAmountCents     Int           @default(29900)
  billingEmail           String?
  manualInvoiceReference String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status])
  @@index([stripeCustomerId])
}

model User {
  id               String     @id @default(cuid())
  tenantId         String     @default("default-tenant")
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fullName         String
  email            String
  passwordHash     String
  role             UserRole
  status           UserStatus @default(active)
  language         String     @default("de")
  expoPushToken    String?
  mfaEnabled       Boolean    @default(false)
  mfaSecret        String?
  mfaPendingSecret String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  driver                          Driver?
  fleetTripClassifications        FleetTrip[]                 @relation("FleetTripClassifiedBy")
  fleetTripPurposeLogs            FleetTripPurposeLog[]       @relation("FleetTripPurposeChangedBy")
  createdAssignments              Assignment[]                @relation("AssignmentCreatedBy")
  createdTours                    Tour[]                      @relation("TourCreatedBy")
  approvedRequests                Request[]                   @relation("ApprovedRequests")
  uploadedDocuments               Document[]                  @relation("DocumentUploadedBy")
  notifications                   Notification[]
  createdConversations            Conversation[]              @relation("ConversationCreatedBy")
  conversationParticipants        ConversationParticipant[]
  sentMessages                    Message[]                   @relation("MessageSentBy")
  messageReads                    MessageRead[]
  auditLogs                       AuditLog[]
  companyMemberships              CompanyUser[]
  passwordResetTokens             PasswordResetToken[]
  createdPasswordResets           PasswordResetToken[]        @relation("PasswordResetCreatedBy")
  sentInvitations                 UserInvitation[]            @relation("InvitationSentBy")
  customerAssignmentMessages      CustomerAssignmentMessage[]
  verifiedLicenseChecks           LicenseCheck[]              @relation("LicenseCheckVerifiedBy")
  defectStatusChanges             DefectStatusLog[]           @relation("DefectStatusChangedByUser")
  createdFines                    Fine[]                      @relation("FineCreatedBy")
  fineStatusChanges               FineStatusLog[]             @relation("FineStatusChangedByUser")
  refreshTokens                   RefreshToken[]
  acknowledgedTachoInfringements  TachoInfringement[]         @relation("TachoInfringementAcknowledgedBy")
  payrollMarkedTachoInfringements TachoInfringement[]         @relation("TachoInfringementPayrollMarkedBy")
  issuedEquipmentIssuances        EquipmentIssuance[]         @relation("EquipmentIssuanceIssuedBy")
  approvedEquipmentIssuances      EquipmentIssuance[]         @relation("EquipmentIssuanceApprovedBy")
  createdInvoices                 Invoice[]                   @relation("InvoiceCreatedBy")
  finalizedInvoices               Invoice[]                   @relation("InvoiceFinalizedBy")
  recordedInvoicePayments         InvoicePayment[]            @relation("InvoicePaymentRecordedBy")
  createdDatevExports             DatevExport[]               @relation("DatevExportCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  /// Rotation chain: when a token is rotated, the replacement's id is stored here.
  replacedById String?
  revokedAt    DateTime?
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserInvitation {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  fullName    String
  role        UserRole
  language    String               @default("de")
  tokenHash   String
  status      UserInvitationStatus @default(pending)
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User                 @relation("InvitationSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())

  @@unique([tenantId, email])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?     @relation("PasswordResetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Driver {
  id                        String                 @id @default(cuid())
  tenantId                  String                 @default("default-tenant")
  tenant                    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId                    String?                @unique
  /// Sürücünün bağlı olduğu müşteri firma (Einsatzplan'daki "Abteilung").
  companyId                 String?
  employeeNumber            String
  firstName                 String
  lastName                  String
  phone                     String?
  email                     String?
  licenseNumber             String?
  licenseExpiryDate         DateTime?
  passportNumber            String?
  passportExpiryDate        DateTime?
  status                    DriverStatus           @default(active)
  riskLevel                 RiskLevel              @default(green)
  notes                     String?
  dateOfBirth               DateTime?              @db.Date
  homeAddressStreet         String?
  homeAddressZipCode        String?
  homeAddressCity           String?
  homeAddressCountry        String?
  vacationEntitlementDays   Decimal                @default(24) @db.Decimal(5, 2)
  vacationCarryOverDays     Decimal                @default(0) @db.Decimal(5, 2)
  lastBirthdayNotifiedYear  Int?
  locationTrackingConsentAt DateTime?
  locationTrackingStatus    LocationTrackingStatus @default(paused)
  locationTrackingEnabledAt DateTime?
  locationSharingStartedAt  DateTime?
  locationSharingEndedAt    DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  currentVehicles         Vehicle[]                     @relation("CurrentVehicleDriver")
  assignments             Assignment[]
  transportRequests       TransportRequest[]
  calendarEvents          CalendarEvent[]
  requests                Request[]
  vehicleHandovers        VehicleHandover[]
  accidents               Accident[]
  morningCheckins         MorningCheckin[]
  conversations           Conversation[]
  locationLatest          DriverLocationLatest?
  locationHistory         DriverLocationHistory[]
  workSessions            WorkSession[]
  serviceRecords          ServiceRecord[]
  driverLicenses          DriverLicense[]
  licenseChecks           LicenseCheck[]
  departureChecks         DepartureCheck[]
  reportedDefects         Defect[]                      @relation("DefectReportedBy")
  defectsToConfirm        Defect[]                      @relation("DefectConfirmationDriver")
  defectStatusChanges     DefectStatusLog[]             @relation("DefectStatusChangedByDriver")
  departureCheckReminders DepartureCheckReminderState[]
  fines                   Fine[]
  fineStatusChanges       FineStatusLog[]               @relation("FineStatusChangedByDriver")
  fleetTrips              FleetTrip[]
  fleetDrivingEvents      FleetDrivingEvent[]
  fleetFuelEntries        FleetFuelEntry[]
  fuelCardTransactions    FuelCardTransaction[]
  dddFiles                DddFile[]
  tachoActivities         TachoActivity[]
  tachoInfringements      TachoInfringement[]
  tachoDownloadSchedules  TachoDownloadSchedule[]
  equipmentIssuances      EquipmentIssuance[]
  tours                   Tour[]
  workTimeEvents          WorkTimeEvent[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([companyId])
}

model DriverLicense {
  id                   String    @id @default(cuid())
  tenantId             String    @default("default-tenant")
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId             String
  licenseNumber        String
  classes              String[]
  issuedAt             DateTime  @db.Date
  expiresAt            DateTime  @db.Date
  issuingAuthority     String
  frontPhotoStoredPath String?
  backPhotoStoredPath  String?
  nextCheckDueAt       DateTime? @db.Date
  checkRequestedAt     DateTime?
  lastReminderSentAt   DateTime?
  lastEscalationSentAt DateTime?
  lastApprovedCheckAt  DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  driver Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  checks LicenseCheck[]

  @@index([tenantId])
  @@index([driverId])
  @@index([expiresAt])
  @@index([nextCheckDueAt])
  @@index([deletedAt])
}

model LicenseCheck {
  id                    String             @id @default(cuid())
  tenantId              String             @default("default-tenant")
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId              String
  driverLicenseId       String?
  checkDate             DateTime           @default(now()) @db.Date
  checkType             LicenseCheckType
  status                LicenseCheckStatus @default(pending)
  verifiedById          String?
  verifiedAt            DateTime?
  rejectionReason       String?
  notes                 String?
  frontPhotoStoredPath  String?
  backPhotoStoredPath   String?
  selfiePhotoStoredPath String?
  photoMetadata         Json?
  dueAt                 DateTime?          @db.Date
  createdAt             DateTime           @default(now())

  driver        Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverLicense DriverLicense? @relation(fields: [driverLicenseId], references: [id], onDelete: SetNull)
  verifiedBy    User?          @relation("LicenseCheckVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([driverId, checkDate])
  @@index([status])
  @@index([driverLicenseId])
}

model Vehicle {
  id                      String          @id @default(cuid())
  tenantId                String          @default("default-tenant")
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plateNumber             String
  internalCode            String
  brand                   String
  model                   String
  year                    Int?
  vin                     String?
  status                  VehicleStatus   @default(active)
  category                VehicleCategory @default(truck)
  currentDriverId         String?
  tuvExpiryDate           DateTime?
  spExpiryDate            DateTime?
  insuranceExpiryDate     DateTime?
  registrationExpiryDate  DateTime?
  photoUrl                String?
  notes                   String?
  avgConsumptionLPer100Km Decimal?        @db.Decimal(6, 2)
  initialOdometerKm       Decimal?        @db.Decimal(12, 3)
  odometerCorrectedKm     Decimal?        @db.Decimal(12, 3)
  odometerCorrectedAt     DateTime?
  deletedAt               DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  currentDriver Driver? @relation("CurrentVehicleDriver", fields: [currentDriverId], references: [id], onDelete: SetNull)

  assignments             Assignment[]
  transportRequests       TransportRequest[]
