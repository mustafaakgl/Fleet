  currency             String                   @default("EUR")
  netCents             Int                      @default(0)
  taxCents             Int                      @default(0)
  grossCents           Int                      @default(0)
  paidCents            Int                      @default(0)
  taxBreakdown         Json?
  customerName         String?
  customerStreet       String?
  customerPostalCode   String?
  customerCity         String?
  customerCountryCode  String?
  customerVatId        String?
  customerEmail        String?
  leitwegId            String?
  supplierSnapshot     Json?
  notes                String?
  originalInvoiceId    String?
  originalInvoice      Invoice?                 @relation("InvoiceCorrections", fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  corrections          Invoice[]                @relation("InvoiceCorrections")
  pdfStoredPath        String?
  pdfSha256            String?
  zugferdXmlStoredPath String?
  zugferdXmlSha256     String?
  xrechnungStoredPath  String?
  xrechnungSha256      String?
  finalizedAt          DateTime?
  sentAt               DateTime?
  paidAt               DateTime?
  cancelledAt          DateTime?
  dunningOptOut        Boolean                  @default(false)
  createdById          String
  createdBy            User                     @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  finalizedById        String?
