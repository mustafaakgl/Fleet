  sourceMimeType   String?
  importedAt       DateTime @default(now())
  totalRows        Int      @default(0)
  matchedRows      Int      @default(0)
  unmatchedRows    Int      @default(0)
  ignoredRows      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions FuelCardTransaction[]

  @@index([tenantId])
  @@map("fuel_card_import_batches")
}

model FuelCardTransaction {
  id                String                    @id @default(cuid())
  tenantId          String                    @default("default-tenant")
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batchId           String
  vehicleId         String?
  driverId          String?
  fuelEntryId       String?
  externalReference String?
  cardLast4         String?
  merchantName      String
  transactionAt     DateTime
  liters            Decimal?                  @db.Decimal(10, 3)
  amount            Decimal                   @db.Decimal(12, 2)
  currency          String                    @default("EUR")
  odometerKm        Decimal?                  @db.Decimal(12, 3)
  status            FuelCardTransactionStatus @default(imported)
  matchScore        Int?
  matchNote         String?
  rawPayload        Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

