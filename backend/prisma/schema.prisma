  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId           String
  driver             Driver                  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  issuedById         String
  issuedBy           User                    @relation("EquipmentIssuanceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  title              String
  items              Json
  formDocumentPath   String
  status             EquipmentIssuanceStatus @default(pending_signature)
  issuedAt           DateTime                @default(now())
  signedAt           DateTime?
  signatureMethod    String?
  signatureImagePath String?
  finalDocumentId    String?                 @unique
  finalDocument      Document?               @relation(fields: [finalDocumentId], references: [id], onDelete: SetNull)
  approvedById       String?
  approvedBy         User?                   @relation("EquipmentIssuanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  clientMeta         Json?
  cancelledAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([tenantId])
  @@index([driverId, status])
  @@index([issuedAt])
  @@index([title])
}

model HandoverPhoto {
  id               String                        @id @default(uuid())
  handoverId       String
  slot             String
  clientRequestId  String?                       @unique @map("client_request_id")
  documentId       String                        @unique
  fileHash         String                        @unique @map("file_hash")
  clientTakenAt    DateTime?                     @map("client_taken_at")
  exifTakenAt      DateTime?                     @map("exif_taken_at")
  gpsLat           Decimal?                      @map("gps_lat") @db.Decimal(10, 7)
  gpsLng           Decimal?                      @map("gps_lng") @db.Decimal(10, 7)
  deviceInfo       String?                       @map("device_info")
  validationStatus HandoverPhotoValidationStatus @default(validated) @map("validation_status")
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  handover VehicleHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([handoverId, slot])
  @@index([handoverId])
  @@map("handover_photos")
}

model VehicleHandover {
  id                        String              @id @default(uuid())
  tenantId                  String              @default("default-tenant")
  tenant                    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId                  String
  vehicleId                 String
  previousVehicleId         String?
  assignmentId              String?
  handoverType              HandoverType
  handoverDateTime          DateTime
  photoRequired             Boolean             @default(false)
  photoStatus               HandoverPhotoStatus @default(not_required)
  damageDetected            Boolean             @default(false)
  damageNotes               String?
  equipmentFirstAidKit      Boolean?
  equipmentFireExtinguisher Boolean?
  equipmentStraps           Boolean?
  equipmentSafetyVest       Boolean?
  equipmentNotes            String?
  equipmentVerifiedAt       DateTime?
  equipmentInventoryChecks  Json?
  status                    HandoverStatus      @default(pending)
  notes                     String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  driver         Driver          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignment     Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  handoverPhotos HandoverPhoto[]

  @@index([tenantId])
  @@index([driverId, handoverDateTime])
  @@index([vehicleId, handoverDateTime])
  @@index([assignmentId])
}

model WorkSession {
  id               String                @id @default(uuid())
  tenantId         String                @default("default-tenant")
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId         String
  driver           Driver                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startedAt        DateTime              @default(now())
  endedAt          DateTime?
  originalEndAt    DateTime?
  correctionReason String?
  lastSeenAt       DateTime?
  source           WorkSessionSource     @default(manual)
  endReason        WorkSessionEndReason?
  status           WorkSessionStatus     @default(active)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  matchedFines    Fine[]
  fleetTrips      FleetTrip[]
  timeEvents      WorkTimeEvent[]
  breakCandidates BreakCandidate[]

  @@index([tenantId])
  @@index([driverId, status])
  @@index([driverId, startedAt])
}

/// Bordro tarafinin tenant ayari.
///
/// TenantBillingProfile'in aynadaki esi: orasi Rechnungswesen (AR/EXTF), burasi
/// Lohn. AYRI tutuluyorlar cunku DATEV'de iki farkli urun ve Mandantennummer
/// bile ayri olabiliyor; birinin ayarini digerine karistirmak yanlis dosyayi
/// yanlis muhasebeye gonderir.
model TenantPayrollProfile {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// YALNIZCA DATEV hedeflerinde anlamli ve yalnizca orada zorunlu. Lexware
  /// Berater-/Mandantennummer kullanmiyor; hazirlik kontrolu bu iki alani
  /// hedefin saglayicisina gore ariyor.
  datevConsultantNumber String?
  datevClientNumber     String?

  /// Tatil listesinin cekildigi eyalet. Bos ise tatil tablosu elle doldurulur.
  bundesland GermanState?

  /// Bu tenant'in bordro hedefi. Surucu profilinde ayrica belirtilmemisse
  /// gecerli olan. Ihracat bunu bilmeden dosya uretemez — her urun farkli duzen
  /// ve farkli Lohnart plani kullaniyor.
  payrollTargetSystem PayrollTargetSystem?

  /// Gece penceresi GUN ICI DAKIKA olarak (0–1439). Repo saatleri "HH:MM"
  /// string tutuyor ama bu pencere gece yarisini asiyor ve dakika aritmetigine
  /// giriyor; string olsaydi her kullanimda cevrilmesi gerekirdi.
  nightWindowStartMinute Int @default(1200) // 20:00
  nightWindowEndMinute   Int @default(360) //  06:00
  /// §3b EStG'nin daha yuksek oranli cekirdek bandi.
  nightCoreStartMinute   Int @default(0) //    00:00
  nightCoreEndMinute     Int @default(240) //  04:00

  /// Gunluk sureler bu adima yuvarlanir. 1 = yuvarlama yok.
  roundingMinutes            Int @default(1)
  /// Takograf dinlenmesinin mola ADAYI sayilmasi icin gereken en kisa sure.
  /// Uc-bes dakikalik REST bloklari mola degil (trafik, rampa, bekleme) ve
  /// aday yapilirsa surucu her gun onlarca gereksiz soru gorur.
  breakCandidateMinMinutes   Int @default(15)
  /// Surucunun bastigi mola ile takografin REST kaydi arasindaki kabul edilen
  /// fark. Ikisi dakikasi dakikasina tutmaz: surucu dugmeye basmayi geciktirir,
  /// takograf aracin duruşundan sayar. Bu esigin USTU incelenmeli.
  tachoBreakToleranceMinutes Int @default(15)
  /// Surucunun kendi hedefi yoksa gecerli olan haftalik hedef.
  defaultWeeklyTargetMinutes Int @default(2400) // 40 saat

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// Surucunun bordro kimligi ve hedefi.
///
/// Gecerlilik araligi (validFrom/validTo) BILEREK yok: donem onaylandiginda
/// PayrollEntry profilin o anki halini snapshot'liyor, gecmis donem yeniden
/// hesaplansa bile dogru degerleri oradan okuyor. Iki ayri tarihce mekanizmasi
/// tutmak gereksiz karmasa olurdu.
model DriverPayrollProfile {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  /// Bu surucunun hangi bordro urunune gittigi. Bos ise tenant varsayilani.
  payrollTargetSystem PayrollTargetSystem?

  /// Hedef sistemdeki personel numarasi (DATEV Personalnummer, Lexware
  /// Personalnummer). Ihracatin BLOKLAYICI kosulu: yoksa donem hazir sayilmiyor
  /// ve dosya uretilmiyor. Saglayicidan bagimsiz adlandirildi cunku her hedef
  /// sistem ayni alani istiyor ve surucu ayni anda ikisine birden gitmiyor.
  ///
  /// Tekillik artik veritabani kisidiyla ZORLANMIYOR cunku profil surumlu:
  /// ayni surucunun iki surumu ayni numarayi tasir. "Ayni anda iki surucude
  /// ayni numara" kontrolu hazirlik dogrulamasinda yapiliyor.
  externalPersonnelNumber String

  /// Bos ise tenant varsayilani gecerli.
  weeklyTargetMinutes  Int?
  /// Dolu ise aylik hedef haftaliktan turetilmez, dogrudan bu kullanilir.
  monthlyTargetMinutes Int?

  costCenter     String?
  costUnit       String?
  employmentType PayrollEmploymentType @default(full_time)

  /// Profil SURUMLU: personel numarasi veya Kostenstelle yil icinde
  /// degisebiliyor ve gecmis bir donem yeniden uretildiginde O TARIHTE
  /// gecerli olan degerler kullanilmali. 4a'da bilerek yoktu; bordro hattinda
  /// gerekli oldugu icin geri geldi.
  validFrom DateTime  @default(now())
  validTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, validFrom])
  @@index([tenantId])
  @@index([tenantId, externalPersonnelNumber])
  @@index([driverId, validFrom])
}

/// Yasal tatil gunleri.
///
/// Takvimdeki FT kaydi ANA KAYNAK DEGIL: o elle girilen planlama izgarasi.
/// Feiertagszuschlag vergi ayricalikli oldugu icin hangi gunun yasal tatil
/// oldugu denetlenebilir bir tablodan gelmeli; takvimdeki FT bu tabloyla
/// karsilastirilip ayrisma anomali olarak gosterilir (takograf REST ile
/// surucunun molasini karsilastirmakla ayni mantik).
///
/// Anahtar (tenantId, date): bir filo pratikte tek eyalette calisiyor ve o
/// eyalet TenantPayrollProfile'da duruyor. `bundesland` burada yalnizca
/// "bu satir hangi listeden geldi" kaydidir, anahtarin parcasi degil.
model PublicHoliday {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  date       DateTime
  name       String
  bundesland GermanState?

  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([tenantId, date])
}

/// Takvim kodu → bordro gun tipi eslemesi.
///
/// Koda gomulmuyor, cunku kod seti tenant'in kendi Einsatzplan aliskanligindan
/// geliyor ve bordro anlamlari sirkete gore degisiyor. Ayrica CalendarStatus
/// enum'u bordro icin fazla bulanik: `WE` hem hafta sonu hem "unent.Fehlen"
/// (biri ucretsiz tatil, digeri ucretten dusulen devamsizlik), `AB` ise
/// eslesmeyen her seyin cop kutusu. Bu yuzden eslesme once CalendarEvent.uiStatus
/// uzerinden aranir, bulunamazsa CalendarStatus'a duser.
model PayrollDayTypeMapping {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// CalendarEvent.uiStatus veya CalendarStatus degeri. Enum DEGIL: uiStatus
  /// serbest metin ('unent.Fehlen', 'k. Auftrag', 'SU') ve enum'da yok.
  calendarCode String
  dayType      PayrollDayType
  /// Ucretli sayilir mi. `work` disindaki tipler icin de anlamli: ucretli izin
  /// ile ucretsiz devamsizligi ayiran alan bu.
  paid         Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, calendarCode])
  @@index([tenantId])
}

/// Bordro donemi (bir takvim ayi).
model PayrollPeriod {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  year   Int
  month  Int
  status PayrollPeriodStatus @default(draft)

  approvedById String?
  approvedBy   User?     @relation("PayrollPeriodApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  lockedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days              PayrollDay[]
  entries           PayrollEntry[]
  exports           PayrollExport[]
  correctionEntries PayrollEntry[]  @relation("PayrollEntryCorrectsPeriod")

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@index([tenantId, status])
}

/// Donem × surucu × YEREL takvim gunu.
///
/// Neden gun satiri var: gece/Pazar/tatil ayrimi gun bazinda doguyor. Yalnizca
/// aylik kova saklansaydi "bu 7 gece saati hangi gunlerden" sorusu bir daha
/// cevaplanamazdi. Fatura tarafindaki Invoice → InvoiceLine iliskisinin ayni
/// deseni: toplam + donmus kalemler.
///
/// Gun YEREL takvim gunudur: gece yarisini asan vardiya iki satira bolunur,
/// cunku zam hesabi dakikanin gerceklestigi gune baglidir.
model PayrollDay {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  driverId String
  driver   Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)

  date DateTime

  /// Eslesme bulunamadiysa BOS kalir ve donem onaylanamaz — sessizce bir
  /// varsayilana dusmek yanlis tarafa da dusebilir.
  dayType       PayrollDayType?
  dayTypeSource PayrollDayTypeSource
  /// Gun tipini veren takvim kodu (uiStatus veya CalendarStatus).
  calendarCode  String?
  paid          Boolean              @default(true)

  workedMinutes    Int @default(0)
  breakMinutes     Int @default(0)
  nightMinutes     Int @default(0)
  nightCoreMinutes Int @default(0)
  sundayMinutes    Int @default(0)
  holidayMinutes   Int @default(0)

  /// Takograf karsilastirmasi. BORDRONUN KAYNAGI DEGIL — surucunun kendi
  /// kaydi ana kayit, bunlar yalnizca dogrulama. Takograf verisi olmayan
  /// gunde ikisi de BOS kalir; sifir yazmak "surucu hic dinlenmedi" demek
  /// olurdu ve DDD dosyasinin gelmemis olmasi bunu ima etmez.
  ///
  /// Yalnizca VARDIYA PENCERESINE dusen REST sayilir: takograf gunluk
  /// dinlenmeyi (gece 11 saat) de REST yaziyor ve onu molayla karsilastirmak
  /// her gunu devasa bir sapma gibi gosterirdi.
  tachoRestMinutes  Int?
  /// Takograf eksi surucu. Pozitif = takograf daha cok dinlenme gormus.
  tachoDeltaMinutes Int?

  /// Zeiterfassung anomalileri + bordroya ozel olanlar (string dizisi).
  anomalies Json?

  createdAt DateTime @default(now())

  @@unique([periodId, driverId, date])
  @@index([tenantId])
  @@index([periodId, driverId])
  @@index([tenantId, driverId, date])
}

/// Donem × surucu toplami — DATEV'e giden satirin kendisi.
model PayrollEntry {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  driverId String
  driver   Driver        @relation(fields: [driverId], references: [id], onDelete: Restrict)

  kind                PayrollEntryKind @default(regular)
  /// Duzeltme kalemi hangi donemi duzeltiyor (Ruckrechnung).
  correctsPeriodId    String?
  correctsPeriod      PayrollPeriod?   @relation("PayrollEntryCorrectsPeriod", fields: [correctsPeriodId], references: [id], onDelete: Restrict)
  /// Duzeltme, kaynak donemin BU ANA kadar gelen degisikliklerini kapsiyor.
  /// Gec gelen olaylar "onaydan sonra yazilmis olay" olarak turetiliyor
  /// (createdAt > approvedAt); bu damga olmadan ayni degisiklik her seferinde
  /// yeniden duzeltme olarak cikardi.
  correctionThroughAt DateTime?

  /// Soll: ay icindeki hedef sure.
  targetMinutes   Int @default(0)
  /// Ist: fiilen calisilan net sure.
  workedMinutes   Int @default(0)
  /// Ucretli devamsizligin hedef uzerinden kredilendigi sure.
  creditedMinutes Int @default(0)
  /// Hedefi asan kisim; DATEV'e ayri Lohnart olarak gider (asilmadiysa 0).
  overtimeMinutes Int @default(0)
  /// Fazla mesai disinda kalan calisma.
  regularMinutes  Int @default(0)
  /// Ist + kredi − Soll. NEGATIF OLABILIR: ekrandaki +6h / −2h bu alan.
  /// overtimeMinutes'tan ayri cunku eksi bakiye odenebilir bir sey degil.
  balanceMinutes  Int @default(0)

  nightMinutes     Int @default(0)
  nightCoreMinutes Int @default(0)
  sundayMinutes    Int @default(0)
  holidayMinutes   Int @default(0)

  vacationDays      Int @default(0)
  sickDays          Int @default(0)
  unpaidAbsenceDays Int @default(0)

  /// Onay aninda donan surucu profili (personel no, Kostenstelle, hedef).
  /// Gecmis donem yeniden hesaplansa bile O GUNKU degerler kullanilsin diye —
  /// InvoiceLine.sourceSnapshot ile ayni gerekce.
  driverProfileSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// NOT: `correctsPeriodId` regular kalemlerde NULL ve Postgres NULL'lari
  /// tekil saymaz. Regular satirin ikinci kez olusmasi pratikte mumkun degil:
  /// yeniden hesap tek islemde sil-ve-yaz olarak calisiyor.
  @@unique([periodId, driverId, kind, correctsPeriodId])
  @@index([tenantId])
  @@index([periodId])
  @@index([tenantId, driverId])
  @@index([correctsPeriodId])
}

/// Bordro kovasi → hedef sistemdeki Lohnart numarasi.
///
/// Numaralar koda gomulmuyor: her Steuerberater kendi Lohnart planini
/// kullaniyor ve bunlar sirkete gore degisiyor.
model PayrollWageTypeMapping {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Hedef urunler AYNI Lohnart planini kullanmak zorunda degil; ayni hareket
  /// turu her urunde farkli numaraya gidebilir.
  targetSystem     PayrollTargetSystem
  movementType     PayrollMovementType
  /// Hedef sistemdeki numara. Model bunu yorumlamiyor, yalnizca tasiyor —
  /// Lohnart olarak okuyan yer adaptordur.
  externalWageType String
  /// Kapali ise bu kova ihracata girmez — her sirket her kovayi ayri Lohnart
  /// olarak gondermiyor (ornegin gece cekirdegini ayirmayan var).
  enabled          Boolean             @default(true)

  /// Lohnart planlari yil icinde degisebiliyor; gecmis donem yeniden
  /// uretildiginde O TARIHTE gecerli olan numara kullanilmali.
  validFrom DateTime  @default(now())
  validTo   DateTime?

  /// Bu kova icin Kostenstelle/Kostentrager surucununkinden farkliysa.
  costCenter String?
  costUnit   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, targetSystem, movementType, validFrom])
  @@index([tenantId])
  @@index([tenantId, targetSystem, movementType])
}

/// Uretilmis bordro dosyasi. DatevExport ile ayni sekil, AYRI tablo.
model PayrollExport {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  /// Notr dosyada BOS: o dosya bir bordro urunune ait degil. Saglayici ayri
  /// alan olarak tutulmuyor, bu degerden turetiliyor.
  targetSystem PayrollTargetSystem?
  format       PayrollExportFormat  @default(neutral_csv)
  /// Ayni donem+urun icin kacinci uretim. Yanlis dosya DUZELTILMEZ, yerine
  /// yenisi uretilir ve eskisi superseded olur.
  version      Int                  @default(1)

  payloadStoredPath String
  payloadSha256     String
  /// Dosyaya giren kalemlerin kimlikleri — dosya ile veri arasindaki bag.
  entryIds          Json
  /// Dosyaya yazilan hareket satiri sayisi. Steuerberater'in "kac kayit
  /// bekliyorum" sorusunun cevabi.
  recordCount       Int                 @default(0)
  status            PayrollExportStatus @default(generated)

  /// Ihracat anindaki KAYNAK VERININ ozeti. Donem sonradan degistiyse
  /// (Ruckrechnung) bu ozet tutmaz ve dosyanin bayatladigi anlasilir.
  sourceHash String

  supersedesExportId String?        @unique
  supersedes         PayrollExport? @relation("PayrollExportSupersede", fields: [supersedesExportId], references: [id], onDelete: SetNull)
  supersededBy       PayrollExport? @relation("PayrollExportSupersede")

  createdById String
  createdBy   User     @relation("PayrollExportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([periodId, targetSystem, format, version])
  @@index([tenantId])
  @@index([periodId, createdAt])
}

/// Zeiterfassung'un ham kaydi: vardiya icindeki her giris/mola/cikis dokunusu.
///
/// APPEND-ONLY. Satir guncellenmez, silinmez; ofis duzeltmesi de yeni bir olay
/// olarak yazilir. Boylece gunun toplami her zaman olay dizisinden yeniden
/// hesaplanabilir ve "kim ne zaman neyi degistirdi" kaybolmaz — Almanya'da
/// baslangic, bitis ve toplam calisma suresinin belgelenmesi zorunlu.
///
/// WorkSession KALDI: vardiyanin kabi ve aktif/bitti durumu orada duruyor,
/// bu tablo onun icindeki detay. Toplamlar hicbir yerde saklanmiyor.
model WorkTimeEvent {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  workSessionId String
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  driverId      String
  driver        Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  type       WorkTimeEventType
  /// Olayin GERCEKLESTIGI an — cevrimdisi yakalanip sonra gonderilebilir, bu
  /// yuzden createdAt'ten ayri tutuluyor. Gun hesabi bunu esas alir.
  occurredAt DateTime
  source     WorkTimeEventSource

  /// Olayin hangi ise/tura denk geldigi. Bos olabilir: mola bir gorevin
  /// ustunde olmak zorunda degil.
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  tourId       String?
  tour         Tour?       @relation(fields: [tourId], references: [id], onDelete: SetNull)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  /// Bu olayin gecersiz kildigi onceki olay. Ofis bir cikisi duzeltince satir
  /// GUNCELLENMEZ, yenisi yazilir ve eskisinin ustunu cizer. Zamana gore
  /// siralama tek basina yetmiyordu: duzeltme saati ileri alirsa katlama
  /// duzeltmeyi degil orijinali uygulardi.
  supersedesEventId String?        @unique
  supersedes        WorkTimeEvent? @relation("WorkTimeEventSupersede", fields: [supersedesEventId], references: [id], onDelete: SetNull)
  supersededBy      WorkTimeEvent? @relation("WorkTimeEventSupersede")

  /// Cevrimdisi kuyruk ayni olayi baglanti gelince tekrar gonderebilir; ayni
  /// kimlik ikinci kez yazilmaz (bkz. TourStop.clientEventId ile ayni desen).
  clientEventId String?
  /// Olayi ureten istemci cihazi. Device modeline FK DEGIL: orasi telematik
  /// kutusu, burada kastedilen surucunun telefonu/tarayicisi.
  deviceId      String?

  createdAt DateTime @default(now())

  /// Bu olayi doguran mola adayi (varsa). Onaylanan aday ile uretilen olay
  /// arasindaki bag iki yonlu tutuluyor ki denetimde "bu mola nereden geldi"
  /// sorusu tek sorguyla cevaplansin.
  breakCandidateStart BreakCandidate? @relation("BreakCandidateStartEvent")
  breakCandidateEnd   BreakCandidate? @relation("BreakCandidateEndEvent")

  @@unique([tenantId, clientEventId])
  @@index([tenantId])
  @@index([workSessionId, occurredAt])
  @@index([tenantId, driverId, occurredAt])
  @@index([assignmentId])
  @@index([tourId])
}

/// Takografin gordugu, HENUZ KAYIT OLMAYAN dinlenme.
///
/// Bu tablo Zeiterfassung'un parcasi DEGIL; onun yanindaki delil defteri.
/// Bordro yalnizca WorkTimeEvent okuyor ve buraya hic bakmiyor — takograf
/// kaydi dogrudan degistirseydi, dogrulanmamis bir olcum maasi degistirirdi.
/// Zincir: TachoActivity -> BreakCandidate -> (insan onayi) -> WorkTimeEvent.
///
/// Aday SILINMIYOR, durum degistiriyor. Reddedilen bir aday silinseydi bir
/// sonraki takograf taramasi ayni oneriyi yeniden uretir ve surucu ayni soruyu
/// her gun tekrar gorurdu; `dismissed` satiri o sorunun sorulmus ve
/// cevaplanmis oldugunun kaydi.
model BreakCandidate {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  /// Aday her zaman bir vardiyaya ait: vardiya penceresi olmadan takograf
  /// dinlenmesi mola degil gunluk istirahattir.
  workSessionId String
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  startedAt       DateTime
  endedAt         DateTime
  /// Tam dakika. Sunucuda bir kez hesaplanip yaziliyor ki liste ekrani ve
  /// karar ani ayni sayiyi gorsun.
  durationMinutes Int

  source BreakCandidateSource @default(tachograph)
  status BreakCandidateStatus @default(pending)

  /// ONERININ GEREKCESI. Alti ay sonra "bu 17 dakikayi neden onerdiniz?"
  /// sorusuna cevap verebilmek icin, adayin turedigi delil oldugu gibi
  /// saklaniyor. Takograf kayitlari sonradan yeniden islenebiliyor; o zaman
  /// bugunku oneriyi yeniden uretmek mumkun olmayabilir, bu yuzden hesabin
  /// girdileri sonucla birlikte donduruluyor.
  ///
  /// evidenceRestMinutes - evidenceRecordedBreakMinutes farki, adayin kendisi
  /// esigi gecen tek parca oldugunda durationMinutes'a esittir; delil blogu
  /// ikiye bolunduyse fark daha buyuk olur.
  evidenceStartedAt            DateTime
  evidenceEndedAt              DateTime
  /// Delil blogunun vardiya penceresi icindeki toplam suresi.
  evidenceRestMinutes          Int
  /// Ayni blogun surucunun kendi kaydettigi molayla ortusen kismi.
  evidenceRecordedBreakMinutes Int
  /// Blogu olusturan TachoActivity kimlikleri. FK DEGIL: takograf kayitlari
  /// yeniden islenirken silinip yeniden yazilabiliyor ve o zaman adayin
  /// gerekcesi de silinirdi.
  evidenceActivityIds          Json
  /// Delilin geldigi DDD dosyalari. Ayni sebeple FK degil.
  evidenceDddFileIds           Json
  /// Turetmenin kosuldugu an. `createdAt` ile ayni degil: aday guncellenirse
  /// (gec gelen daha eksiksiz DDD) bu tazelenir, createdAt tazelenmez.
  derivedAt                    DateTime

  decidedAt      DateTime?
  /// Karari veren kisi. Surucu kendi telefonundan onayladiysa da dolu —
  /// "kim onayladi" sorusu denetimde sorulacak sorulardan biri.
  decidedById    String?
  decidedBy      User?                @relation("BreakCandidateDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Kararin hangi kanaldan geldigi; WorkTimeEvent.source ile ayni dil.
  decisionSource WorkTimeEventSource?

  /// Onay sonucu yazilan olaylar — dosyadan veriye geri yol. SetNull degil
  /// Restrict de degil: olay silinmiyor zaten (append-only), ama iliskinin
  /// kendisi zorunlu degil cunku reddedilen adayda olay yok.
  breakStartEventId String?        @unique
  breakStartEvent   WorkTimeEvent? @relation("BreakCandidateStartEvent", fields: [breakStartEventId], references: [id], onDelete: SetNull)
  breakEndEventId   String?        @unique
  breakEndEvent     WorkTimeEvent? @relation("BreakCandidateEndEvent", fields: [breakEndEventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Uretim TEKRARLANABILIR olmali: her DDD indirmesinde ve her ekran acilista
  /// yeniden taraniyor. Baslangic ani capa: ayni dinlenme ikinci kez aday
  /// olmuyor, verilmis karar da geri gelmiyor.
  @@unique([tenantId, workSessionId, startedAt])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, driverId, startedAt])
  @@index([workSessionId, status])
}

