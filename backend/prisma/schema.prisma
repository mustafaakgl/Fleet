  tenantId                   String         @default("default-tenant")
  tenant                     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId                  String
  reportedByDriverId         String
  source                     DefectSource
  departureCheckId           String?
  departureCheckItemResultId String?
  title                      String?
  description                String
  severity                   DefectSeverity
  status                     DefectStatus   @default(offen)
  photoStoredPaths           String[]
  photoMetadata              Json?
  repairCompany              String?
  estimatedRepairDate        DateTime?      @db.Date
  serviceRecordId            String?
  confirmationDriverId       String?
  confirmedAt                DateTime?
  anonymizedAt               DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  vehicle                  Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
