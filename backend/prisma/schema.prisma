/// Geocode edilmis, yeniden kullanilabilir adres. Ayni adres tenant icinde bir kez
/// geocode edilir (normalizedHash), sonraki gorevler ayni kaydi paylasir.
model Location {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Kullanicinin girdigi ham metin — geriye donuk izlenebilirlik icin saklanir
  rawAddress     String
  /// Kucuk harf + noktalama/bosluk sadelestirilmis hali; tenant ici tekillik anahtari
  normalizedHash String
  /// Operasyonda gorunen ad, ornegin "Werk Duisburg" veya "Rampe 3"
  label          String?
  street         String?
  houseNumber    String?
  postalCode     String?
  city           String?
  countryCode    String  @default("DE")

  latitude          Decimal?       @db.Decimal(10, 7)
  longitude         Decimal?       @db.Decimal(10, 7)
  geocodeSource     GeocodeSource?
  geocodeConfidence Decimal?       @db.Decimal(4, 3)
  geocodedAt        DateTime?

  truckAccess          TruckAccessStatus @default(unknown)
  truckAccessCheckedAt DateTime?
  /// Koordinatin snap edildigi kamyon yoluna mesafe (m); buyuk deger supheli geocode
  truckSnapDistanceM   Decimal?          @db.Decimal(8, 2)
  truckAccessNote      String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupAssignments   Assignment[] @relation("AssignmentPickupLocation")
  deliveryAssignments Assignment[] @relation("AssignmentDeliveryLocation")
  tourDepots          Tour[]       @relation("TourDepot")
  tourStops           TourStop[]   @relation("TourStopLocation")
  consignmentPickups   Consignment[] @relation("ConsignmentPickupLocation")
  consignmentDeliveries Consignment[] @relation("ConsignmentDeliveryLocation")

  @@unique([tenantId, normalizedHash])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([tenantId, truckAccess])
}

/// Bir aracin bir gunluk sirali durak dizisi.
///
/// Tek alis + tek teslimden olusan uzun yol gorevi bunun ozel durumudur
/// (iki durak); ayri bir yapiya gerek yok. Assignment kaydi korunur — Tour
/// onun uzerine gecen bir planlama katmani, yerine gecen bir sey degil.
model Tour {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name           String?
  workDate       DateTime
  /// Aracin ilk duraktan kalkis ani. ETA'nin dayanagi budur: verilmezse
  /// bacak sureleri yine hesaplanir ama mutlak varis saati uretilemez.
  plannedStartAt DateTime?
  /// Son duraktaki isin bitis ani; optimizasyon sonrasi hesaplanir.
  plannedEndAt   DateTime?
  status         TourStatus @default(draft)
  vehicleId      String?
  vehicle        Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)

  /// Turun baslangic/bitis noktasi. Bos ise ilk/son durak esas alinir.
  depotLocationId String?
  depotLocation   Location? @relation("TourDepot", fields: [depotLocationId], references: [id], onDelete: SetNull)

  /// Optimizasyon ciktisi. Gerceklesen degerlerle karsilastirmak icin
  /// saklanir — sapma raporunun tur duzeyindeki karsiligi.
  plannedDistanceKm  Decimal? @db.Decimal(12, 3)
  plannedDurationMin Int?
  plannedFuelLiters  Decimal? @db.Decimal(10, 3)
  /// Maut tahmini. Valhalla tutar hesaplamadigi icin kendi katmanimiz doldurur;
  /// hesaplanamadiginda null kalir ve rapor bunu "bilinmiyor" olarak gosterir.
  plannedTollCents   Int?

  /// Optimizasyon oncesi durum — kullaniciya "once/sonra" gostermek icin.
  /// Optimizasyon kabul edilmezse geri donulecek referans da budur.
  baselineDistanceKm  Decimal? @db.Decimal(12, 3)
  baselineDurationMin Int?

  optimizedAt       DateTime?
  /// Arka plan isinin kimligi; ayni tur icin ikinci is baslatilmasini engeller
  optimizationJobId String?
  /// Optimizasyon basarisiz olduysa kullaniciya gosterilecek sebep.
  /// Ornegin kamyona kapali bir durak tum turu cokertir.
  optimizationError String?

  createdById String
  createdBy   User     @relation("TourCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stops          TourStop[]
  workTimeEvents WorkTimeEvent[]
  /// Yakit niyetleri turun PLANINA girmez — yalnizca bu tura ait olduklari
  /// bilinsin diye baglanir. Durak sayisi ve sirasi bundan etkilenmez.
  fuelingIntents FuelingIntent[]

  @@index([tenantId])
  @@index([tenantId, workDate])
  @@index([tenantId, vehicleId, workDate])
  @@index([tenantId, driverId, workDate])
  @@index([tenantId, status])
}

/// Turdaki tek bir durak.
model TourStop {
  id       String @id @default(cuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  /// Yurutulecek sira. Optimizasyon bunu yeniden yazar.
  sequence        Int
  /// Kullanicinin girdigi ilk sira — optimizasyonun ne degistirdigini
  /// gostermek ve gerekirse geri donmek icin korunur.
  plannedSequence Int?

  kind       TourStopKind
  locationId String
  location   Location     @relation("TourStopLocation", fields: [locationId], references: [id], onDelete: Restrict)

  /// Durak bir gorevden turetildiyse baglantisi. Bos olabilir: depo duraklari
  /// ve serbest eklenen duraklar bir goreve ait degildir.
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  /// Musterinin kabul ettigi zaman araligi, "HH:MM". Repo genelinde saatler
  /// string tutuluyor (bkz. Assignment.startTime); ayni desen izlendi.
  windowStart    String?
  windowEnd      String?
  /// Durakta gecen sure (bosaltma, evrak). Cok durakli dagitimda planin
  /// buyuk bolumunu bu olusturur.
  serviceMinutes Int     @default(0)

  weightKg Decimal? @db.Decimal(10, 2)
  volumeM3 Decimal? @db.Decimal(10, 3)

  /// Optimizasyon ciktisi
  plannedArrivalAt   DateTime?
  plannedDepartureAt DateTime?
  /// Bir onceki duraktan bu duraga olan bacak
  legDistanceKm      Decimal?  @db.Decimal(12, 3)
  legDurationMin     Int?
  /// Bir onceki duraktan bu duraga olan bacagin cizim govdesi (Valhalla
  /// encoded polyline, precision 6). Haritada rotayi bacak bacak cizmek icin;
  /// tur duzeyinde tek govde tutulsaydi durak vurgulanamazdi.
  legShape           String?

  /// Yurutme kaydi. Planlama alanlarindan ayri: plan optimizasyonla yeniden
  /// yazilabilir, gerceklesen ise degismez.
  status             TourStopStatus @default(pending)
  arrivedAt          DateTime?
  completedAt        DateTime?
  /// Isaretleme anindaki telefon konumu. Sonradan "orada degildim" itirazi
  /// gelirse elimizde tek kanit bu.
  completedLatitude  Decimal?       @db.Decimal(10, 7)
  completedLongitude Decimal?       @db.Decimal(10, 7)
  /// Cevrimdisi kuyruk ayni isaretlemeyi baglanti gelince tekrar gonderebilir.
  /// Son uygulanan istemci olayinin kimligi; ayni kimlik yeniden gelirse islem
  /// tekrarlanmaz. Sira bozulmasina karsi ayrica durum gerilemesi engelleniyor
  /// (bkz. tour-stop.service).
  clientEventId      String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bu duraga giderken onerilmis yakit niyetleri. YALNIZCA baglam bagi:
  /// `sequence` ve durak sirasi bu iliskiden etkilenmez.
  anchoredFuelingIntents FuelingIntent[]

  @@unique([tourId, sequence])
  @@index([tenantId])
  @@index([tourId])
  /// Tur yurutme ekraninin canonical sorgusu: bir turun ACIK duraklari.
  /// Indeks 20260808200000_tour_stop_execution ile veritabaninda ZATEN vardi;
  /// semaya yazilmasi unutulmustu ve bu, her `migrate dev` kosusunun onu
  /// dusurmeye calismasi anlamina geliyordu.
  @@index([tourId, status])
  @@index([tenantId, locationId])
  @@index([assignmentId])
}

model Assignment {
  id                   String           @id @default(cuid())
  tenantId             String           @default("default-tenant")
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId             String
  vehicleId            String
  companyId            String
  cargoName            String
  cargoOwner           String
  pickupAddress        String
  deliveryAddress      String
  /// Geocode edilmis karsiliklari. String alanlar geriye donuk uyumluluk icin
  /// korunur — backfill tamamlanana kadar bu alanlar bos olabilir.
  pickupLocationId     String?
  deliveryLocationId   String?
  workDate             DateTime
  startTime            String?
  endTime              String?
  routeName            String?
  /**
   * OPERASYON DILIMINE AYRILAN GELIR (Faz 15'te anlami netlesti).
   *
   * Faz 15 bu alanin YANINA ikinci bir gelir alani ACMADI: aynı anlamda iki
   * alan, iki farkli toplam demektir. Siparis geliri `TransportOrder`da,
   * dilime ayrilan pay burada.
   *
   * PARA BIRIMI `currency` ALANINDA — bkz. asagisi.
   */
  expectedDailyRevenue Decimal?         @db.Decimal(10, 2)

  /**
   * GELIRIN PARA BIRIMI — OLUSTURULDUGU ANDA DONDURULUR.
   *
   * Faz 15 bu alani bilincli olarak ACMAMISTI: para birimi bagli oldugu
   * siparisten cozulur denmisti. O tasarim IKI YERDE kirildi ve denetimde
   * ortaya cikti:
   *
   *   1. Siparisin para birimi sonradan degistiginde (EUR→TRY amendment)
   *      ESKI gorevin tutari sessizce yeni para biriminde okunur hale
   *      geliyordu. 1.200 EUR'luk bir is, hicbir sey yazilmadan 1.200 TRY
   *      oluyordu.
   *   2. Toplama alan hicbir tuketici (dashboard, maliyet paneli, fatura
   *      onerisi) siparise bakmiyor — dogrudan `expectedDailyRevenue`
   *      topluyordu. `FleetFuelEntry`, `ServiceRecord` ve `Fine` icin var olan
   *      `matchesBaseCurrency` korumasi burada YOKTU cunku korunacak bir alan
   *      yoktu.
   *
   * KAYNAK: siparisten uretilen gorev, uretildigi ANDAKI siparis
   * revizyonunun para birimini alir ve sonraki amendment bunu DEGISTIRMEZ.
   * Bagimsiz gorev kiracinin `baseCurrency`sini alir. Tutar ve para birimi
   * AYNI transaction'da yaziliyor — ikisinin ayri yazilmasi, arada bir
   * okumanin yanlis para biriminde tutar gormesi demekti.
   *
   * VARSAYILAN YOK: veritabani `EUR` yazsaydi, TRY tabanli bir kiracinin
   * gorevleri sessizce yanlis para biriminde acilirdi. NOT NULL olmasi da
   * bilincli — Prisma tipleri her olusturma yolunu karar vermeye zorluyor.
   */
  currency             String

  status               AssignmentStatus @default(planned)

  /**
   * --- Faz 15: TICARI SIPARIS BAGI (hepsi NULLABLE) ---
   *
   * NULLABLE KALMAK ZORUNDA: bugunku kayitlarin hicbirinin siparisi yok ve
   * sofor talebinden (`TransportRequest`) dogan isler bir musteri siparisine
   * ait olmayabilir. Eski kayitlar UYDURMA siparislere BAGLANMAZ.
   *
   * Bir Assignment YALNIZ BIR siparise ait olabilir. Bolunmus siparis birden
   * fazla Assignment uretir; aktarma gerekiyorsa tek Assignment birden fazla
   * tura baglanmaz, ayri operasyon dilimleri kullanilir.
   */
  transportOrderId String?
  transportOrder   TransportOrder? @relation(fields: [transportOrderId], references: [id], onDelete: SetNull)
  consignmentId    String?
  consignment      Consignment?    @relation(fields: [consignmentId], references: [id], onDelete: SetNull)
  /**
   * Planin URETILDIGI siparis revizyonu.
   *
   * Siparis degistiginde bu alan GERIDE KALIR ve arayuz "guncel siparisten
   * farkli" uyarisi gosterir. Otomatik guncellenmez: yola cikmis bir gorevi
   * sessizce degistirmek, sofora haber vermeden isini degistirmektir.
   */
  sourceRevision   Int?
  notes                String?
  createdById          String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  driver           Driver                      @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle          Vehicle                     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  company          Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  pickupLocation   Location?                   @relation("AssignmentPickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull)
  deliveryLocation Location?                   @relation("AssignmentDeliveryLocation", fields: [deliveryLocationId], references: [id], onDelete: SetNull)
  createdBy        User                        @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  calendarEvents   CalendarEvent[]
  transportRequest TransportRequest?           @relation("TransportRequestAssignment")
  vehicleHandovers VehicleHandover[]
  accidents        Accident[]
  morningCheckins  MorningCheckin[]
  customerMessages CustomerAssignmentMessage[]
  departureChecks  DepartureCheck[]
  matchedFines     Fine[]
  fleetTrips       FleetTrip[]
  invoiceLines     InvoiceLine[]
  invoiceClaim     InvoiceAssignmentClaim?
  tourStops        TourStop[]
  workTimeEvents   WorkTimeEvent[]

  @@index([tenantId])
  @@index([driverId, workDate])
  @@index([vehicleId, workDate])
  @@index([companyId, workDate])
  @@index([transportOrderId])
  @@index([consignmentId])
  /// Toplama sorgulari kiraci + para birimi uzerinden suzuyor.
  @@index([tenantId, currency])
}

model RateCard {
