  taxCents             Int                      @default(0)
  grossCents           Int                      @default(0)
  paidCents            Int                      @default(0)
  taxBreakdown         Json?
  customerName         String?
  customerStreet       String?
  customerPostalCode   String?
  customerCity         String?
  customerCountryCode  String?
  customerVatId        String?
  customerEmail        String?
  leitwegId            String?
