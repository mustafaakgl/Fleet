model DddFile {
  id                     String                  @id @default(cuid())
  tenantId               String                  @default("default-tenant")
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId              String?
  vehicle                Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId               String?
  driver                 Driver?                 @relation(fields: [driverId], references: [id], onDelete: SetNull)
  uploadedByUserId       String?
  fileType               DddFileType
  source                 DddFileSource           @default(manual)
  capturedAt             DateTime
  storedPath             String
  sizeBytes              Int
  sha256                 String
  generation             Int?
  signatureValid         Boolean?
  skippedBlocks          Json?
  status                 DddFileProcessingStatus @default(pending)
  processingErrorSummary String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  activities                 TachoActivity[]
  infringements              TachoInfringement[]
  fulfilledDownloadSchedules TachoDownloadSchedule[] @relation("TachoScheduleFulfilledByFile")

  @@unique([tenantId, sha256])
  @@index([tenantId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([tenantId, status])
  @@map("ddd_files")
}

