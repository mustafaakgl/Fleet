DATABASE_URL="postgresql://fleet:fleet123@localhost:5432/fleet"
NODE_ENV=development
# For Docker Compose backend container, use:
# DATABASE_URL="postgresql://fleet:fleet123@postgres:5432/fleet"
# Generate: openssl rand -base64 32
JWT_SECRET="development_jwt_secret_minimum_32_chars"
JWT_EXPIRES_IN="8h"
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
FRONTEND_URL="http://localhost:3001"
API_PUBLIC_URL="http://localhost:3000/api/v1"
# OpenAPI docs are opt-in. Keep false in production unless explicitly approved.
SWAGGER_ENABLED=false
# Set true to allow POST /auth/signup (public SaaS registration)
ALLOW_PUBLIC_SIGNUP=false
# Comma-separated emails allowed to access /fleet-ops (tenant provisioning UI)
FLEET_OPS_EMAILS="ops@myfleet.app"
# Optional API key for scripts: header X-Fleet-Ops-Key
FLEET_OPS_API_KEY=
DATA_CONTROLLER_NAME="[FIRMENNAME]"
PRIVACY_CONTACT_EMAIL="privacy@example.com"
LOCATION_HISTORY_RETENTION_DAYS=90
DRIVER_LOCATION_HISTORY_RETENTION_DAYS=90
TELEMETRY_PROCESSED_RECORD_RETENTION_DAYS=30
FLEET_DRIVING_EVENT_RETENTION_DAYS=180
TELEMETRY_QUARANTINE_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=10000
RETENTION_CRON_ENABLED=true
REMINDER_CRON_ENABLED=true
LICENSE_CHECK_CRON_ENABLED=true
# 32-byte key: openssl rand -hex 32 (encrypts license photos at rest)
LICENSE_PHOTO_ENCRYPTION_KEY=
# Months after driver termination before license photos/checks are purged
LICENSE_CHECK_RETENTION_MONTHS=6
BIRTHDAY_CRON_ENABLED=true
DEPARTURE_CHECK_CRON_ENABLED=true
# 32-byte key: openssl rand -hex 32 (falls back to LICENSE_PHOTO_ENCRYPTION_KEY)
DEFECT_PHOTO_ENCRYPTION_KEY=
# Months after BESTÄTIGT before defect photos/description are anonymized
DEFECT_RETENTION_MONTHS=24
FINE_MANAGEMENT_CRON_ENABLED=true
FLEET_TRIP_CRON_ENABLED=true
FLEET_MAINTENANCE_CRON_ENABLED=true
# Falls back to DEFECT_PHOTO_ENCRYPTION_KEY / LICENSE_PHOTO_ENCRYPTION_KEY
FINE_DOCUMENT_ENCRYPTION_KEY=
# Daily 18:00 Europe/Berlin: generate tomorrow company Einsatzplan emails
COMPANY_EMAIL_CRON_ENABLED=true
# When true, the cron job also sends via SMTP. Default is false: the office
# reviews and edits the draft, then sends it. Turning this on mails customers
# without any human looking at the text first.
COMPANY_EMAIL_AUTO_SEND=false
# Production: SMTP_ENABLED=true is enforced when NODE_ENV=production (see docs/ops/SMTP-GO-LIVE.md)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyFleet <noreply@myfleet.app>"
# Optional: recipient for `npm run verify:smtp` pre-deploy test
SMTP_VERIFY_TO=
# Production: set STRIPE_ENABLED=true + live keys (see docs/ops/STRIPE-GO-LIVE.md)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Requires Stripe Tax registration on your account
STRIPE_AUTOMATIC_TAX=false
PORT=3000
DEVICE_PORT=5027
DEVICE_HOST=127.0.0.1
# Commissioning a new tracker: log the IO elements the device actually sends,
# so AVL ids are read off the hardware instead of guessed from a datasheet.
# Leave off in normal operation — it writes one log line per record.
# See docs/telematik-fmc003-devreye-alma.md
TELEMATICS_IO_CAPTURE=false
TELEMATICS_IO_CAPTURE_IMEI=
TELEMATICS_IO_CAPTURE_LIMIT=50
# Ops: probe GET /api/v1/health (liveness) and GET /api/v1/health/ready (DB)
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_TIMEOUT_MS=5000
MESSENGER_TRANSLATION_ENABLED=true
MFA_ISSUER="Fleet"

# Object storage (local disk by default; STORAGE_DRIVER=s3 required in production)
STORAGE_DRIVER=local
S3_BUCKET=fleet-uploads
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Production: protect /api/v1/metrics (Bearer token)
METRICS_TOKEN=
REDIS_URL=

# Production: comma-separated allowed origins
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Error monitoring (optional)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# GDPR retention (daily cron at 03:00 Europe/Berlin)
# DriverLocationHistory: 90d, TelemetryProcessedRecord: 30d, FleetDrivingEvent: 180d,
# TelemetryQuarantine: 30d. FleetTrip / TachoActivity / DddFile are not purged here.
AUDIT_LOG_RETENTION_DAYS=730
NOTIFICATION_RETENTION_DAYS=730
MESSAGE_RETENTION_DAYS=730
DOCUMENT_EXPIRY_GRACE_DAYS=30

# Daily backup: scripts/backup-daily.sh (cron + DATABASE_URL)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Seed helper
SEED_SILENT=false

# Telematics ingest and simulation
CODEC8_SIM_COUNT=5
CODEC8_SIM_IMEI=359339080000101
CODEC8_SIM_INTERVAL_MS=2000
TELEMATICS_SIM_BASE_URL=http://localhost:3000/api/v1
TELEMATICS_SIM_INTERVAL_MS=2000
TELEMATICS_SIM_VEHICLE_IDS=
DEVICE_INGEST_TOKEN=
TACHO_INGEST_TOKEN=
TELEMATICS_IGNITION_OFF_DEBOUNCE_MS=5000
TELEMATICS_SPEEDING_KPH=90
TELEMATICS_HARSH_ACCEL_KPH=12
TELEMATICS_HARSH_BRAKE_KPH=12
TELEMATICS_COOLANT_HIGH_C=105
TELEMATICS_VOLTAGE_LOW_V=11.8
TELEMATICS_FUEL_THEFT_DROP_PCT=15
TELEMATICS_FUEL_THEFT_WINDOW_MS=600000
TELEMATICS_ALARM_SUPPRESSION_MS=14400000
TELEMATICS_DEVICE_SILENT_MS=1800000
TELEMATICS_WATCHDOG_INTERVAL_MS=300000

# Hangi yakit istasyonu saglayicisi kullanilacak: tankerkoenig | mock
# `mock` deterministik, AG CAGRISI YAPMAYAN demo istasyonlar uretir; gercek
# anahtar gelmeden surucu ekranini uctan uca calistirmak icin. NODE_ENV=production
# iken `mock` secilirse uygulama ACILISTA durur — sahte fiyat surucuye ulasmamali.
FUEL_STATION_PROVIDER=mock
# FUEL_STATION_PROVIDER=tankerkoenig

# Fuel station prices (Tankerkoenig, creativecommons.tankerkoenig.de).
# Anahtar YALNIZCA backend'de kullanilir; hicbir yanit ya da log'a girmez.
# Bos ise surucu ucu 503 fuel_station_provider_not_configured doner — sistem
# calismaya devam eder, sadece istasyon fiyati gosterilmez.
TANKERKOENIG_API_KEY=
TANKERKOENIG_TIMEOUT_MS=5000
# Fiyat gun icinde degisir; rota onbelleginden (7 gun) bilincli olarak ayri.
FUEL_STATION_CACHE_TTL_SECONDS=300

# Tachograph credentials and remote provider
TACHO_PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
TACHO_DOWNLOAD_REMINDER_CRON_ENABLED=true
TACHO_ACK_SLA_CRON_ENABLED=true
TACHO_ACK_SLA_DAYS=7
TIS_WEB_BASE_URL=
TIS_WEB_LIST_PATH=/api/download/list
TIS_WEB_DOWNLOAD_PATH=/api/download/file

# Optional OIDC SSO
SSO_OIDC_ENABLED=false
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_REDIRECT_URI=
SSO_OIDC_SCOPES="openid profile email"
SSO_OIDC_ALLOWED_ROLES="admin,boss,office"
SSO_OIDC_BUTTON_LABEL="SSO Login"

# Trust X-Forwarded-For so rate limits key on the real client IP. Set only when
# the API sits behind a proxy you control (tunnel, load balancer). Values: true,
# a hop count, or an Express trust-proxy expression such as "loopback".
# TRUST_PROXY=true

# --- Tankbeleg-OCR (Faz 10) ---------------------------------------------
# disabled = OCR kapali, Fahrer fuellt das Formular manuell (VORGABE)
# mock     = Demo-Daten, in production VERBOTEN
# azure_document_intelligence = echter Anbieter
FUEL_RECEIPT_OCR_PROVIDER=disabled

# Nur noetig, wenn der Anbieter azure_document_intelligence ist.
# Der Schluessel gehoert in den Secret Manager, NICHT in diese Datei und
# niemals ins Repository. Hier stehen ausschliesslich Beispielwerte.
# In production muss der Endpoint HTTPS sein.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
# Erlaubt sind ausschliesslich EU-Regionen. ACHTUNG: dieser Wert ist eine
# Angabe, kein Nachweis — die Ressource muss tatsaechlich in der EU angelegt
# werden (siehe docs/PILOT-LAUNCH-CHECKLIST.md).
AZURE_DOCUMENT_INTELLIGENCE_REGION=westeurope
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-receipt
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_MS=25000

# --- Ordivan otomasyonu (Faz 12) ---
# disabled | mock | local
#   disabled — Ordivan kapali; uclar 503 doner, Fleet calismaya devam eder.
#   mock     — Deterministik sahte worker. YALNIZCA development/test.
#   local    — Gercek Ordivan (Faz 12'de kullanilmiyor).
# `mock` URETIMDE ACILISTA REDDEDILIR.
ORDIVAN_CONNECTOR_MODE=disabled
