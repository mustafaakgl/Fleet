# Local development defaults. For production copy: cp .env.production.example .env

POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet123

DATABASE_URL=postgresql://fleet:fleet123@postgres:5432/fleet
JWT_SECRET=secret
BACKEND_PORT=3000
FRONTEND_PORT=3001
NODE_ENV=development
PORT=3000
START_BACKEND_ON_DEV=true

FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
BACKEND_INTERNAL_URL=http://localhost:3000

# Test phase: auto-login on /login (default on in development, set false to disable)
NEXT_PUBLIC_AUTO_LOGIN=true
# NEXT_PUBLIC_AUTO_LOGIN_EMAIL=admin@fleet.com
# NEXT_PUBLIC_AUTO_LOGIN_PASSWORD=admin123

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyFleet <noreply@myfleet.app>"

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_TIMEOUT_MS=5000
MESSENGER_TRANSLATION_ENABLED=true

# Optional infra and verification
REDIS_URL=
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe (set when billing is enabled)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_AUTOMATIC_TAX=false

# Object storage
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Privacy and email
DATA_CONTROLLER_NAME=[FIRMENNAME]
PRIVACY_CONTACT_EMAIL=privacy@example.com
CORS_ORIGIN=http://localhost:3001

# Telematics scripts
DEVICE_HOST=127.0.0.1
DEVICE_PORT=5027
CODEC8_SIM_IMEI=359339080000101
CODEC8_SIM_COUNT=5
CODEC8_SIM_INTERVAL_MS=2000
TELEMATICS_IGNITION_OFF_DEBOUNCE_MS=5000
TELEMATICS_SIM_BASE_URL=http://localhost:3000/api/v1
TELEMATICS_SIM_INTERVAL_MS=2000
TELEMATICS_SIM_VEHICLE_IDS=
DEVICE_INGEST_TOKEN=
TACHO_INGEST_TOKEN=

# Local tooling
LOOP_VERIFY_DEVICE_PORT=15027
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
SKIP_PLAYWRIGHT_E2E=false
QA_MOBILE_API_BASE_URL=http://localhost:3000/api/v1
QA_MOBILE_EMAIL=
QA_MOBILE_PASSWORD=
