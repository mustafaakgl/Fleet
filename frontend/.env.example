NODE_ENV=development
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
BACKEND_INTERNAL_URL="http://localhost:3000"
NEXT_PUBLIC_DATA_CONTROLLER_NAME="[FIRMENNAME]"
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL="privacy@example.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@myfleet.app"
NEXT_PUBLIC_SUPPORT_HOURS="Mo–Fr 9–17 Uhr (CET)"
NEXT_PUBLIC_AUTO_LOGIN=true
NEXT_PUBLIC_AUTO_LOGIN_EMAIL=
NEXT_PUBLIC_AUTO_LOGIN_PASSWORD=

# Legal imprint fields
NEXT_PUBLIC_LEGAL_ADDRESS="Musterstrasse 1, 10115 Berlin"
NEXT_PUBLIC_LEGAL_REGISTER_COURT="Amtsgericht Berlin"
NEXT_PUBLIC_LEGAL_REGISTER_NUMBER="HRB 123456"
NEXT_PUBLIC_LEGAL_VAT_ID="DE123456789"

# Marketing / leads (optional)
NEXT_PUBLIC_WHATSAPP_PHONE="493012345678"
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_SALES_CONTACT_EMAIL="vertrieb@myfleet.de"
NEXT_PUBLIC_LANDING_STAT_VEHICLES="1847"
NEXT_PUBLIC_LANDING_STAT_DOCUMENTS="5420"
NEXT_PUBLIC_LANDING_STAT_ALERTS="312"
NEXT_PUBLIC_PARTNER_NAME="Ümit Han"
NEXT_PUBLIC_PARTNER_COMPANY=""
NEXT_PUBLIC_PARTNER_VEHICLES="70"
NEXT_PUBLIC_PARTNER_QUOTE=""

# Error monitoring (optional — leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Set by Next.js at runtime; keep default empty for local files.
NEXT_RUNTIME=
SENTRY_AUTH_TOKEN=
